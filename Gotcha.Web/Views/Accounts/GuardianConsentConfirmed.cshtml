@{
	ViewData["Title"] = "Consent Confirmed";
}

<h1 class="fw-bold font-bungee text-center">Consent Confirmed</h1>

<div class="card glowingCard col-11 col-lg-6 mx-auto mt-4">
	<div class="card-body text-center py-5">
		<h2 class="font-robotoSlab fw-bold color-2 mb-4">Thank you!</h2>
		<p class="text-white font-roboto fs-5 mb-4">You have given consent for @ViewBag.UserName to use Gotcha. They can now log in.</p>
		<a asp-controller="Home" asp-action="Index" class="btn-1 px-4 py-2">Go to Gotcha</a>
	</div>
</div>
