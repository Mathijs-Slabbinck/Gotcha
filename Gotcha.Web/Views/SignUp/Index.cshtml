<link rel="stylesheet" href="~/css/SignUp.css" />
<script src="~/js/signUp.js" ></script>

<h1 class="fw-bold font-bungee text-center">Welcome to GOTCHA!</h1>

<form class="card">
	<div class="card-header row">
		<div class="col-12 d-flex justify-content-center">
			<h2 class="text-center font-robotoSlab fw-bold mt-2 color-3 py-2">SIGN UP</h2>
			<p class="text-end infoIcon" id="info-general" data-toggle="modal" data-target="#infoModal">&#9432;</p>
		</div>
	</div>
	<div class="card-body row mt-3">
		<div class="col-12 col-lg-6">
			<div class="row justify-content-center">
				<div class="col-9">
					<div class="row labelBlock">
						<label class="fw-bold color-2 mb-2 fs-6 font-roboto col-10" for="signUpFirstNameInput">First Name: *</label>
						<p class="text-end col-2 infoIcon" id="info-firstName" data-toggle="modal" data-target="#infoModal">&#9432;</p>
					</div>
				</div>
				<input class="col-9" id="signUpFirstNameInput" type="text" placeholder="John" />
			</div>
		</div>
		<div class="col-12 col-lg-6 mt-lg-0 mt-4 justify-content-center">
			<div class="row justify-content-center">
				<div class="col-9">
					<div class="row">
						<label class="fw-bold color-2 mb-2 fs-6 font-roboto col-10" for="signUpLastNameInput">Last Name: *</label>
						<p class="text-end col-2 infoIcon" id="info-lastName">&#9432;</p>
					</div>
				</div>
				<input class="col-9" id="signUpLastNameInput" type="text" placeholder="Doe" />
			</div>
		</div>
	</div>
	<div class="card-body row mt-3">
		<div class="col-12 col-lg-6">
			<div class="row justify-content-center">
				<div class="col-9">
					<div class="row">
						<label class="col-10 fw-bold color-2 mb-2 fs-6 font-roboto" for="signUpUsernameInput">Username: *</label>
						<p class="text-end col-2 infoIcon" id="info-username">&#9432;</p>
					</div>
				</div>
				<input class="col-9" id="signUpUsernameInput" type="text" placeholder="TheLegend27" required />
			</div>
		</div>
		<div class="col-12 col-lg-6 mt-lg-0 mt-4 mt-lg-3">
			<div class="row justify-content-center">
				<div class="col-9">
					<div class="row">
						<label class="col-10 fw-bold color-2 mb-2 fs-6 font-roboto" for="signUpUsernameInput">Email Adress: *</label>
						<p class="text-end col-2 infoIcon" id="info-emailAdress">&#9432;</p>
					</div>
				</div>
				<input class="col-9" id="signUpEmailInput" type="text" placeholder="john.doe@gmail.com" required />
			</div>
		</div>
	</div>
	<div class="card-body row mt-3">
		<div class="col-12 col-lg-6 mt-lg-0 mt-3">
			<div class="row justify-content-center">
				<div class="col-9">
					<div class="row">
						<label class="col-10 fw-bold color-2 mb-2 fs-6 font-roboto" for="signUpBirthDayInput">BirthDay: *</label>
						<p class="text-end col-2 infoIcon" id="info-birthday">&#9432;</p>
					</div>
				</div>
				<input class="col-9" id="signUpBirthDayInput" type="date" required />
			</div>
		</div>
		<div class="col-12 col-lg-6 mt-lg-0 mt-3">
			<div class="row justify-content-center">
				<div class="col-9">
					<div class="row">
						<label class="col-10 fw-bold color-2 mb-2 fs-6 font-roboto" for="signUpGenderInput">Gender: *</label>
						<p class="text-end col-2 infoIcon" id="info-gender">&#9432;</p>
					</div>
				</div>
				<select class="col-9 text-secondary" id="signUpGenderInput" required>
					<option disabled selected>Select a Gender</option>
					<option>Male</option>
					<option>Female</option>
					<option>Other</option>
					<option>Prefer Not To Say</option>
				</select>
			</div>
		</div>
	</div>
	<div class="card-body row justify-content-center mt-3">
		<div class="col-12 col-lg-6">
			<div class="row justify-content-center">
				<div class="col-9">
					<div class="row">
						<label class="col-10 fw-bold color-2 mb-2 fs-6 font-roboto" for="signUpImageInput">Picture:</label>
						<p class="text-end col-2 infoIcon" id="info-picture">&#9432;</p>
					</div>
				</div>
				<div class="row justify-content-center">
					<div class="col-11">
						<input id="signUpImageInput" type="file" accept="image/*" class="form-control">
					</div>
				</div>
			</div>
		</div>
	</div>
	<div class="row justify-content-center my-3">
		<input type="submit" class="btn-1 col-2 mb-2" />
	</div>
</form>

<div class="modal fade" id="infoModal" role="dialog" tabindex="-1">
	<div class="modal-dialog" role="document">
		<div class="modal-content">
			<div class="modal-header justify-content-center">
				<h5 class="modal-title infoModalTitle">Modal title</h5>
				<button type="button" class="close modalClose" data-dismiss="modal" aria-label="Close">
					<span aria-hidden="true">&times;</span>
				</button>
			</div>
			<div class="modal-body text-center">
				<p class="infoModalText">Modal body text goes here.</p>
			</div>
		</div>
	</div>
</div>