@{
	ViewData["Title"] = "Reset Failed";
}

<h1 class="fw-bold font-bungee text-center">Reset Failed</h1>

<div class="card glowingCard col-11 col-lg-6 mx-auto mt-4">
	<div class="card-body text-center py-5">
		<h2 class="font-robotoSlab fw-bold color-2 mb-4">Something went wrong</h2>
		<p class="text-white font-roboto fs-5 mb-4">This reset link is invalid or has expired. Please request a new one.</p>
		<a asp-controller="ResetPassword" asp-action="Index" class="btn-1 px-4 py-2">Try Again</a>
	</div>
</div>
