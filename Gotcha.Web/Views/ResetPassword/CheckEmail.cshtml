@{
	ViewData["Title"] = "Check Your Email";
}

<h1 class="fw-bold font-bungee text-center">Check Your Email</h1>

<div class="card glowingCard col-11 col-lg-6 mx-auto mt-4">
	<div class="card-body text-center py-5">
		<h2 class="font-robotoSlab fw-bold color-2 mb-4">Reset link sent!</h2>
		<p class="text-white font-roboto fs-5 mb-3">If an account with that email exists, we sent a password reset link.</p>
		<p class="text-white font-roboto mb-4">Check your inbox and click the link to set a new password.</p>
		<a asp-controller="Home" asp-action="Index" class="btn-1 px-4 py-2">Back to Login</a>
	</div>
</div>
