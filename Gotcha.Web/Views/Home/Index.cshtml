@model Gotcha.Web.ViewModels.HomeViewModel

@{
	ViewData["Title"] = "Welcome";
}

<script src="~/js/indexPage.js"></script>

<h1 class="fw-bold font-bungee text-center mb-5">Welcome to GOTCHA!</h1>

<div class="row mb-5">
		<div class="card mt-3 col-11 mx-auto flex-row loginFormCard glowingCard">
			<div class="row">
				<div class="col-12 col-lg-6" id="loginFormCardLeft">
					<div class="row justify-content-center text-center">
						<h2 class="col-12 text-center font-robotoSlab fw-bold card-header mb-4 fs-3 py-3 color-3">SIGN IN</h2>
						<form asp-controller="Accounts" asp-action="Login" method="post" class="row my-1">
							<div asp-validation-summary="ModelOnly" class="text-danger text-center"></div>
							<div class="col-12 mb-2">
								<div class="row justify-content-center form-group">
									<label class="col-7 fw-bold color-2 mb-1 font-roboto fs-6" asp-for="Email">Email:</label>
									<input asp-for="Email" id="loginEmailInput" class="col-7 text-center" type="email" placeholder="john.doe@example.com" />
									<span asp-validation-for="Email" class="col-7 text-danger"></span>
								</div>
								<div class="row justify-content-center form-group mt-4">
									<label class="col-7 fw-bold color-2 mb-1 font-roboto fs-6" asp-for="Password">Password:</label>
									<div class="col-7">
										<div class="row justify-content-end">
											<input asp-for="Password" id="loginPasswordInput" class="col-12 text-center mb-4" type="password" placeholder="password" />
											<p class="col-1 clickAble eye d-flex justify-content-end" id="eye-login">&#x1F441;</p>
										</div>
									</div>
								<span asp-validation-for="Password" class="col-7 text-danger"></span>
								</div>
							</div>
						<input type="submit" id="loginSignInButton" class="btn-1 col-5 mb-2 mx-auto" value="log in">
							<div class="d-flex align-items-center justify-content-center mt-2">
								<input asp-for="RememberMe" id="loginRememberMeCheckbox" class="form-check-input me-2" type="checkbox" />
								<label asp-for="RememberMe" class="fw-bold color-2 font-roboto fs-6 mb-0">Remember me</label>
							</div>
							<a asp-controller="ResetPassword" asp-action="Index" class="my-1 mt-4">Forgot password?</a>
						</form>
					</div>
				</div>
				<div class="col-12 col-lg-6 bg-1" id="loginFormCardRight">
					<div class="row justify-content-center text-center">
						<h2 class="col-12 text-center text-white font-robotoSlab fw-bold card-header mb-4 fs-3 py-3">WELCOME</h2>
						<div class="row my-5">
							<p class="fw-bolder mt-3 col-12">Please log in to continue.</p>
							<p class="fw-bolder mt-2 col-12">If you don't have an account yet, you can <a asp-controller="SignUp" asp-action="Index">sign up</a>.</p>
							<a asp-controller="SignUp" asp-action="Index" id="loginSignUpButton" class="fw-bolder btn-2 col-5 my-4 mx-auto">sign up</a>
						</div>
					</div>
				</div>
			</div>
		</div>
	</div>
