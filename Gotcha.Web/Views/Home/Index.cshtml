<link rel="stylesheet" href="~/css/Index.css" />

<h1 class="fw-bold font-bungee text-center mb-5">Welcome to GOTCHA!</h1>

<div class="row mb-5">
	<div class="card mt-3 col-11 mx-auto flex-row loginFormCard">
		<div class="row">
			<div class="col-12 col-lg-6" id="loginFormCardLeft">
				<div class="row justify-content-center text-center">
					<h2 class="col-12 text-center font-robotoSlab fw-bold card-header mb-4 fs-3 py-3">SIGN IN</h2>
					<form class="row my-1">
						<div class="col-12 mb-2">
							<label class="col-7 fw-bold color-2 mb-1 font-roboto" for="loginEmailInput">Email:</label>
							<input id="loginEmailInput" class="col-7 text-center" type="text" placeholder="john.doe@example.com" />
							<label class="col-7 mt-4 fw-bold color-2 mb-1 font-roboto" for="loginPasswordInput">Password:</label>
							<input id="loginPasswordInput" class="col-7 text-center mb-4" type="password" placeholder="password" />
						</div>
						<input type="submit" id="loginSignInButton" class="btn-1 col-5 mb-4 mx-auto" value="log in">
						<a class="my-1">Forgot password?</a>
					</form>
				</div>
			</div>
			<div class="col-12 col-lg-6 bg-1" id="loginFormCardRight">
				<div class="row justify-content-center text-center">
					<h2 class="col-12 text-center text-white font-robotoSlab fw-bold card-header mb-4 fs-3 py-3">WELCOME</h2>
					<div class="row my-5">
						<p class="fw-bolder mt-3 col-12">Please log in to continue.</p>
						<p class="fw-bolder mt-2 col-12">If you don't have an account yet, you can <a asp-controller="SignUp" asp-action="Index">sign up</a>.</p>
						<a asp-controller="SignUp" asp-action="Index" id="loginSingUpButton" class="fw-bolder btn-2 col-5 my-4 mx-auto">sign up</a>
					</div>
				</div>
			</div>
		</div>
	</div>
</div>
