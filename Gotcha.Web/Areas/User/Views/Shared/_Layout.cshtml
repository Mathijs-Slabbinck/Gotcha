<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>GOTCHA - @ViewData["Title"]</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Gotcha.Web.styles.css" asp-append-version="true" />

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Bungee&family=Nosifer&family=Roboto+Slab:wght@100..900&family=Roboto:ital,wght@0,100..900;1,100..900&display=swap" rel="stylesheet">
    <link rel="apple-touch-icon" sizes="57x57" href="~/images/favicons/apple-icon-57x57.png">
    <link rel="apple-touch-icon" sizes="60x60" href="~/images/favicons/apple-icon-60x60.png">
    <link rel="apple-touch-icon" sizes="72x72" href="~/images/favicons/apple-icon-72x72.png">
    <link rel="apple-touch-icon" sizes="76x76" href="~/images/favicons/apple-icon-76x76.png">
    <link rel="apple-touch-icon" sizes="114x114" href="~/images/favicons/apple-icon-114x114.png">
    <link rel="apple-touch-icon" sizes="120x120" href="~/images/favicons/apple-icon-120x120.png">
    <link rel="apple-touch-icon" sizes="144x144" href="~/images/favicons/apple-icon-144x144.png">
    <link rel="apple-touch-icon" sizes="152x152" href="~/images/favicons/apple-icon-152x152.png">
    <link rel="apple-touch-icon" sizes="180x180" href="~/images/favicons/apple-icon-180x180.png">
    <link rel="icon" type="image/png" sizes="192x192" href="~/images/favicons/android-icon-192x192.png">
    <link rel="icon" type="image/png" sizes="32x32" href="~/images/favicons/favicon-32x32.png">
    <link rel="icon" type="image/png" sizes="96x96" href="~/images/favicons/favicon-96x96.png">
    <link rel="icon" type="image/png" sizes="16x16" href="~/images/favicons/favicon-16x16.png">
    <link rel="manifest" href="/manifest.json">
    <meta name="msapplication-TileColor" content="#ffffff">
    <meta name="msapplication-TileImage" content="/ms-icon-144x144.png">
    <meta name="theme-color" content="#ffffff">
</head>
<body>
    <div id="bodyBackground">
    <header>
        <nav class="noSelect bigScreenNav">
                <div class="row maxWidth100">
                <div class="col-12 col-md-10 col-lg-10">
                    <ul class="row align-items-center">
                        <li class="col-2">
                            <span class="navLogoBackground navLogoBackgroundBigScreen"></span>
                            <figure class="navLogoContainer clickAble">
                                <img class="navLogoImage img-fluid" src="~/images/logoFullPng.png" />
                                <figcaption class="navLogoText font-nosifer">GOTCHA</figcaption>
                            </figure>
                        </li>
                        <li class="col-2 mt-5 text-center fw-bold fs-4 font-robotoSlab"><a asp-controller="Home" asp-action="Index">Home</a></li>
                        <li class="col-2 mt-5 text-center fw-bold fs-4 font-robotoSlab"><a asp-controller="Games" asp-action="Index">Games</a></li>
                        <li class="col-2 mt-5 text-center fw-bold fs-4 font-robotoSlab text-nowrap"><a asp-controller="Settings" asp-action="Index">User Settings</a></li>
                        <li class="col-2 mt-5 text-center fw-bold fs-4 font-robotoSlab text-nowrap"><a asp-controller="Store" asp-action="Index">Unlock Features</a></li>
                    </ul>
                </div>
            </div>
        </nav>

        <nav class="noSelect smallScreenNav">
            <ul class="row align-items-center justify-content-between">
                <li class="col-8 justify-content-center d-flex">
                    <figure class="navLogoBackground clickAble d-flex flex-row align-items-center justify-content-between row">
                        <img class="img-fluid col-5" src="~/images/logoFullPng.png" />
                        <figcaption class="col-7 font-nosifer">GOTCHA</figcaption>
                    </figure>
                </li>
                <li class="col-3 pb-3">
                    <div class="menuContainer">
                        <div class="bar1"></div>
                        <div class="bar2"></div>
                        <div class="bar3"></div>
                    </div>
                </li>
            </ul>
        </nav>

    </header>

    <div class="menuOpenNavContainer">
        <div class="row justify-content-center menuOpenNav mx-auto">
            <div class="col-10">
                <ul class="row card glowingCard p-0 mt-4">
                    <li class="col-12 my-4 py-4"><a asp-controller="Home" asp-action="Index">Home</a></li>
                    <li class="col-12 my-4 py-4"><a asp-controller="Games" asp-action="Index">Games</a></li>
                    <li class="col-12 my-4 py-4"><a asp-controller="Settings" asp-action="Index">User Settings</a></li>
                    <li class="col-12 my-4 py-4"><a asp-controller="Store" asp-action="Index">Unlock Features</a></li>
                </ul>
            </div>
        </div>
    </div>

    <div class="fullsvh">
    </div>

    <div class="container">
        <main role="main" class="pb-1">
            @RenderBody()
        </main>
    </div>
    </div>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>