@using Gotcha.Web.Areas.User.ViewModels;

@{
	ViewData["Title"] = "New Game";
}

<script src="~/js/newGamePage.js"></script>

@model NewGameViewModel

<div class="row mb-3">
	<h1 class="col-12 text-center fw-bold font-bungee">New Game</h1>
</div>

<!-- ===== GAME SETTINGS CARD ===== -->
<div class="card glowingCard formBg mt-4 col-10 col-xl-11 mx-auto p-0 mb-5">
	<div class="card-header row">
		<h2 class="col-12 text-center font-robotoSlab fw-bold color-2 mt-3">Game Settings</h2>
	</div>

	<div class="row justify-content-center my-4">
		<div class="col-10 col-md-8">

			<!-- Game Name -->
			<div class="row align-items-center mb-3 settingRow">
				<div class="col-8 d-flex align-items-center">
					<label for="gameName" class="settingLabel">Game Name</label>
					<p class="infoIcon settingInfoIcon m-0" data-title="Game Name" data-info="The name of your game. This is what players will see when they join or look at their games list.">&#9432;</p>
				</div>
				<div class="col-4">
					<input type="text" id="gameName" class="form-control" value="@Model.Name" placeholder="Enter game name" />
				</div>
			</div>

			<!-- Custom Rules -->
			<div class="row mb-3 settingRow">
				<div class="col-12">
					<div class="d-flex align-items-center mb-2">
						<label for="customRules" class="settingLabel">Custom Rules:</label>
						<p class="infoIcon settingInfoIcon m-0" data-title="Custom Rules" data-info="Add any house rules for your game. These will be shown to all players so everyone knows what's allowed and what's not.">&#9432;</p>
					</div>
					<textarea id="customRules" class="form-control customRulesTextarea" rows="4" placeholder="e.g. No kills during class, Safe zones in dorms, No kills at work">@(Model.CustomRules != null ? String.Join(", ", Model.CustomRules) : "")</textarea>
				</div>
			</div>

			<!-- Show Player Images -->
			<div class="row align-items-center mb-3 settingRow">
				<div class="col-8 d-flex align-items-center">
					<label for="showPlayerImages" class="settingLabel">Show Player Images</label>
					<p class="infoIcon settingInfoIcon m-0" data-title="Show Player Images" data-info="When enabled, players can see each other's profile images during the game.">&#9432;</p>
				</div>
				<div class="col-4 text-end">
					<label class="toggle-switch">
						<input type="checkbox" id="showPlayerImages" checked="@Model.ShowPlayerImages" />
						<span class="toggle-slider"></span>
					</label>
				</div>
			</div>

			<!-- Show Gender -->
			<div class="row align-items-center mb-3 settingRow">
				<div class="col-8 d-flex align-items-center">
					<label for="showGender" class="settingLabel">Show Gender</label>
					<p class="infoIcon settingInfoIcon m-0" data-title="Show Gender" data-info="When enabled, players without a profile image will see a gender-based placeholder. When disabled, a neutral placeholder is shown instead. This setting is not available when Enforce Player Images is on, since all players will have an image.">&#9432;</p>
				</div>
				<div class="col-4 text-end">
					<label class="toggle-switch">
						<input type="checkbox" id="showGender" checked="@Model.ShowGender" />
						<span class="toggle-slider"></span>
					</label>
				</div>
			</div>

			<!-- Enforce Player Images -->
			<div class="row align-items-center mb-3 settingRow">
				<div class="col-8 d-flex align-items-center">
					<label for="enforcePlayerImages" class="settingLabel">Enforce Player Images</label>
					<p class="infoIcon settingInfoIcon m-0" data-title="Enforce Player Images" data-info="When enabled, all players are required to upload a profile image before the game can start. Turning this on will disable Show Gender, since placeholders are no longer needed.">&#9432;</p>
				</div>
				<div class="col-4 text-end">
					<label class="toggle-switch">
						<input type="checkbox" id="enforcePlayerImages" checked="@Model.EnforcePlayerImages" />
						<span class="toggle-slider"></span>
					</label>
				</div>
			</div>

			<!-- Show Real Names -->
			<div class="row align-items-center mb-3 settingRow">
				<div class="col-8 d-flex align-items-center">
					<label for="showRealNames" class="settingLabel">Show Real Names</label>
					<p class="infoIcon settingInfoIcon m-0" data-title="Show Real Names" data-info="When enabled, players' real names are visible during the game. At least one of Show Real Names or Show Usernames must always be on.">&#9432;</p>
				</div>
				<div class="col-4 text-end">
					<label class="toggle-switch">
						<input type="checkbox" id="showRealNames" checked="@Model.ShowRealNames" />
						<span class="toggle-slider"></span>
					</label>
				</div>
			</div>

			<!-- Show Usernames -->
			<div class="row align-items-center mb-3 settingRow">
				<div class="col-8 d-flex align-items-center">
					<label for="showUsernames" class="settingLabel">Show Usernames</label>
					<p class="infoIcon settingInfoIcon m-0" data-title="Show Usernames" data-info="When enabled, players' usernames are visible during the game. At least one of Show Real Names or Show Usernames must always be on.">&#9432;</p>
				</div>
				<div class="col-4 text-end">
					<label class="toggle-switch">
						<input type="checkbox" id="showUsernames" checked="@Model.ShowUsernames" />
						<span class="toggle-slider"></span>
					</label>
				</div>
			</div>

			<!-- Show Living Player Count -->
			<div class="row align-items-center mb-3 settingRow">
				<div class="col-8 d-flex align-items-center">
					<label for="showLivingPlayerCount" class="settingLabel">Show Living Player Count</label>
					<p class="infoIcon settingInfoIcon m-0" data-title="Show Living Player Count" data-info="When enabled, all players can see how many players are still alive in the game.">&#9432;</p>
				</div>
				<div class="col-4 text-end">
					<label class="toggle-switch">
						<input type="checkbox" id="showLivingPlayerCount" checked="@Model.ShowLivingPlayerCount" />
						<span class="toggle-slider"></span>
					</label>
				</div>
			</div>

			<!-- Show Living Player Names -->
			<div class="row align-items-center mb-3 settingRow">
				<div class="col-8 d-flex align-items-center">
					<label for="showLivingPlayerNames" class="settingLabel">Show Living Player Names</label>
					<p class="infoIcon settingInfoIcon m-0" data-title="Show Living Player Names" data-info="When enabled, all players can see the names of players who are still alive. Turning this on will also enable Show Living Player Names to Dead.">&#9432;</p>
				</div>
				<div class="col-4 text-end">
					<label class="toggle-switch">
						<input type="checkbox" id="showLivingPlayerNames" checked="@Model.ShowLivingPlayerNames" />
						<span class="toggle-slider"></span>
					</label>
				</div>
			</div>

			<!-- Show Living Player Names to Dead -->
			<div class="row align-items-center mb-3 settingRow">
				<div class="col-8 d-flex align-items-center">
					<label for="showLivingPlayerNamesToDead" class="settingLabel">Show Living Player Names to Dead</label>
					<p class="infoIcon settingInfoIcon m-0" data-title="Show Living Player Names to Dead" data-info="When enabled, eliminated players can still see who is alive. This is automatically turned on when Show Living Player Names is enabled.">&#9432;</p>
				</div>
				<div class="col-4 text-end">
					<label class="toggle-switch">
						<input type="checkbox" id="showLivingPlayerNamesToDead" checked="@Model.ShowLivingPlayerNamesToDeath" />
						<span class="toggle-slider"></span>
					</label>
				</div>
			</div>

			<!-- Assassin Mode -->
			<div class="row align-items-center mb-3 settingRow">
				<div class="col-8 d-flex align-items-center">
					<label for="assassinMode" class="settingLabel">Assassin Mode</label>
					<p class="infoIcon settingInfoIcon m-0" data-title="Assassin Mode" data-info="In Assassin Mode, players can try to eliminate whoever they think is hunting them. If they guess wrong, they get eliminated instead. Requires the Assassin Mode unlock from the store.">&#9432;</p>
				</div>
				<div class="col-4 text-end">
					<label class="toggle-switch">
						@if (Model.AssassinModeUnlocked)
						{
							<input type="checkbox" id="assassinMode" checked="@Model.IsAssassin" />
						}
						else
						{
							<input type="checkbox" id="assassinMode" checked="@Model.IsAssassin" disabled />
						}
						<span class="toggle-slider"></span>
					</label>
				</div>
			</div>

			<!-- Show Hunter -->
			<div class="row align-items-center mb-3 settingRow">
				<div class="col-8 d-flex align-items-center">
					<label for="showHunter" class="settingLabel">Show Hunter</label>
					<p class="infoIcon settingInfoIcon m-0" data-title="Show Hunter" data-info="When enabled, players can see who is currently hunting them. Only available when Assassin Mode is active.">&#9432;</p>
				</div>
				<div class="col-4 text-end">
					<label class="toggle-switch">
						@if (Model.AssassinModeUnlocked && Model.IsAssassin)
						{
							<input type="checkbox" id="showHunter" checked="@Model.ShowHunter" />
						}
						else
						{
							<input type="checkbox" id="showHunter" checked="@Model.ShowHunter" disabled />
						}
						<span class="toggle-slider"></span>
					</label>
				</div>
			</div>

			<!-- Chaos Mode -->
			<div class="row align-items-center mb-3">
				<div class="col-8 d-flex align-items-center">
					<label for="chaosMode" class="settingLabel">Chaos Mode</label>
					<p class="infoIcon settingInfoIcon m-0" data-title="Chaos Mode" data-info="In Chaos Mode, targets get randomly reassigned at random intervals within the timer range you set. Requires the Chaos Mode unlock from the store.">&#9432;</p>
				</div>
				<div class="col-4 text-end">
					<label class="toggle-switch">
						@if (Model.ChaosModeUnlocked)
						{
							<input type="checkbox" id="chaosMode" checked="@Model.IsChaos" />
						}
						else
						{
							<input type="checkbox" id="chaosMode" checked="@Model.IsChaos" disabled />
						}
						<span class="toggle-slider"></span>
					</label>
				</div>
			</div>

			<!-- Chaos Timer -->
			<div class="row align-items-center mb-3 settingRow timerRow">
				<div class="col-4 d-flex align-items-center">
					<label class="settingLabel timerLabel">Chaos Timer (hours)</label>
					<p class="infoIcon settingInfoIcon m-0" data-title="Chaos Timer" data-info="Set the minimum and maximum hours between target reassignments. The actual time will be randomly picked within this range.">&#9432;</p>
				</div>
				<div class="col-8 text-end d-flex justify-content-end align-items-center gap-2">
					@if (Model.IsChaos)
					{
						<input type="number" id="chaosTimerMin" class="form-control timerInput" value="@Model.ChaosTimerMinHours" min="1" />
					}
					else
					{
						<input type="number" id="chaosTimerMin" class="form-control timerInput" value="@Model.ChaosTimerMinHours" min="1" disabled />
					}
					<span class="timerLabel settingLabel">to</span>
					@if (Model.IsChaos)
					{
						<input type="number" id="chaosTimerMax" class="form-control timerInput" value="@Model.ChaosTimerMaxHours" min="1" />
					}
					else
					{
						<input type="number" id="chaosTimerMax" class="form-control timerInput" value="@Model.ChaosTimerMaxHours" min="1" disabled />
					}
				</div>
			</div>

			<!-- Timed Kills -->
			<div class="row align-items-center mb-3">
				<div class="col-8 d-flex align-items-center">
					<label for="timedKills" class="settingLabel">Timed Kills</label>
					<p class="infoIcon settingInfoIcon m-0" data-title="Timed Kills" data-info="When enabled, players have a limited amount of time to eliminate their target. Requires the Timed Kills unlock from the store.">&#9432;</p>
				</div>
				<div class="col-4 text-end">
					<label class="toggle-switch">
						@if (Model.TimedKillsUnlocked)
						{
							<input type="checkbox" id="timedKills" checked="@Model.IsTimed" />
						}
						else
						{
							<input type="checkbox" id="timedKills" checked="@Model.IsTimed" disabled />
						}
						<span class="toggle-slider"></span>
					</label>
				</div>
			</div>

			<!-- Target Timeout -->
			<div class="row align-items-center mb-3 settingRow timerRow">
				<div class="col-8 d-flex align-items-center">
					<label for="targetTimeout" class="settingLabel timerLabel">Target Timeout (hours)</label>
					<p class="infoIcon settingInfoIcon m-0" data-title="Target Timeout" data-info="The number of hours a player has to eliminate their target before they time out.">&#9432;</p>
				</div>
				<div class="col-4 text-end">
					@if (Model.IsTimed)
					{
						<input type="number" id="targetTimeout" class="form-control timerInput" value="@Model.TargetTimeOutHours" min="1" />
					}
					else
					{
						<input type="number" id="targetTimeout" class="form-control timerInput" value="@Model.TargetTimeOutHours" min="1" disabled />
					}
				</div>
			</div>

			<!-- Custom Kill Methods -->
			<div class="row align-items-center mb-3">
				<div class="col-8 d-flex align-items-center">
					<label for="customKillMethods" class="settingLabel">Custom Kill Methods</label>
					<p class="infoIcon settingInfoIcon m-0" data-title="Custom Kill Methods" data-info="When enabled, you can define specific ways players are allowed to eliminate each other.">&#9432;</p>
				</div>
				<div class="col-4 text-end">
					<label class="toggle-switch">
						<input type="checkbox" id="customKillMethods" checked="@Model.CustomKillMethods" />
						<span class="toggle-slider"></span>
					</label>
				</div>
			</div>

			<!-- Kill Methods Input -->
			<div class="row mb-3 settingRow" id="killMethodsSection">
				<div class="col-12">
					<div class="d-flex align-items-center mb-2">
						<label for="killMethods" class="settingLabel">Kill Methods:</label>
						<p class="infoIcon settingInfoIcon m-0" data-title="Kill Methods" data-info="List the allowed elimination methods, separated by commas. Players will choose from these when confirming a kill.">&#9432;</p>
					</div>
					@if (Model.CustomKillMethods && Model.KillMethods != null)
					{
						<input type="text" id="killMethods" class="form-control" value="@String.Join(", ", Model.KillMethods)" placeholder="e.g. Nerf Gun, Water Balloon, Tag" />
					}
					else
					{
						<input type="text" id="killMethods" class="form-control" placeholder="e.g. Nerf Gun, Water Balloon, Tag" disabled />
					}
					<small class="text-light">Separate methods with commas</small>
				</div>
			</div>

			<!-- Invite Link -->
			<div class="row mb-3">
				<div class="col-12">
					<div class="d-flex align-items-center mb-2">
						<label class="settingLabel">Join Link:</label>
						<p class="infoIcon settingInfoIcon m-0" data-title="Join Link" data-info="Share this link with players so they can join your game. Anyone with the link can join until the game starts.">&#9432;</p>
					</div>
					<div class="input-group">
						<input type="text" id="inviteLink" class="form-control inviteLinkInput" value="@Model.InviteLink" readonly />
						<button class="btn btn-1 copyLinkBtn">Copy Link</button>
					</div>
				</div>
			</div>

		</div>
	</div>
</div>

<!-- ===== CREATE GAME BUTTON ===== -->
<div class="row justify-content-center mb-5">
	<button class="col-8 col-md-6 col-lg-4 btn-1 fs-4 py-2 createGameBtn">Create Game</button>
</div>

<!-- ===== SETTINGS INFO MODAL ===== -->
<div class="modal fade" id="settingsInfoModal" role="dialog" tabindex="-1">
	<div class="modal-dialog" role="document">
		<div class="modal-content">
			<div class="modal-header justify-content-center">
				<h5 class="modal-title infoModalTitle">Setting Info</h5>
				<button type="button" class="btn-close modalClose" data-bs-dismiss="modal" aria-label="Close"></button>
			</div>
			<div class="modal-body text-center">
				<p class="infoModalText">Info about this setting.</p>
			</div>
		</div>
	</div>
</div>
