@using Gotcha.Core.Enums;
@using Gotcha.Shared.Enums;
@using Gotcha.Web.Areas.User.ViewModels;

@{
	ViewData["Title"] = "Store";
}

@model StoreViewModel

<script src="https://www.paypal.com/sdk/js?client-id=@Model.PayPalClientId&currency=USD" data-sdk-integration-source="button-factory"></script>
<script src="~/js/storePage.js"></script>

<div class="row mb-3">
	<h1 class="col-12 text-center fw-bold font-bungee">Unlock Features</h1>
</div>

<!-- ===== CARD 1: GAME FEATURES ===== -->
<div class="card glowingCard formBg mt-4 col-10 col-xl-11 mx-auto p-0 mb-5">
	<div class="card-header row">
		<div class="col-12 d-flex justify-content-center align-items-center mt-3">
			<h2 class="text-center font-robotoSlab fw-bold color-2 m-0">Game Features</h2>
			<p class="infoIcon storeInfoIcon m-0" data-title="Game Features" data-info="Game features are permanent one-time purchases linked to your account. Once unlocked, you can enable them in any game you create. All players in your lobby will be able to play with these settings for free, only the game creator needs to own the feature.">&#9432;</p>
		</div>
	</div>

	<div class="row justify-content-center my-4">
		<div class="col-10 col-md-8">

			<!-- Assassin Mode -->
			<div class="row align-items-center mb-3 featureRow">
				<p class="col-5 mb-0 featureLabel">Assassin Mode</p>
				<p class="col-3 mb-0 text-center featurePrice">$3.00</p>
				<div class="col-4 text-end">
					@if (Model.AssassinUnlocked)
					{
						<span class="ownedBadge">Owned</span>
					}
					else
					{
						<div id="paypal-btn-AssassinMode"></div>
					}
				</div>
			</div>

			<!-- Chaos Mode -->
			<div class="row align-items-center mb-3 featureRow">
				<p class="col-5 mb-0 featureLabel">Chaos Mode</p>
				<p class="col-3 mb-0 text-center featurePrice">$2.00</p>
				<div class="col-4 text-end">
					@if (Model.ChaosUnlocked)
					{
						<span class="ownedBadge">Owned</span>
					}
					else
					{
						<div id="paypal-btn-ChaosMode"></div>
					}
				</div>
			</div>

			<!-- Timed Kills -->
			<div class="row align-items-center mb-3 featureRow">
				<p class="col-5 mb-0 featureLabel">Timed Kills</p>
				<p class="col-3 mb-0 text-center featurePrice">$2.00</p>
				<div class="col-4 text-end">
					@if (Model.TimedKillsUnlocked)
					{
						<span class="ownedBadge">Owned</span>
					}
					else
					{
						<div id="paypal-btn-TimedKills"></div>
					}
				</div>
			</div>

			<!-- Different Kill Methods -->
			<div class="row align-items-center mb-3 featureRow">
				<p class="col-5 mb-0 featureLabel">Different Kill Methods</p>
				<p class="col-3 mb-0 text-center featurePrice">$2.00</p>
				<div class="col-4 text-end">
					@if (Model.CustomKillMethodsUnlocked)
					{
						<span class="ownedBadge">Owned</span>
					}
					else
					{
						<div id="paypal-btn-CustomKillMethods"></div>
					}
				</div>
			</div>

		</div>
	</div>
</div>

<!-- ===== CARD 2: LOBBY SIZE ===== -->
<div class="card glowingCard formBg mt-4 col-10 col-xl-11 mx-auto p-0 mb-5">
	<div class="card-header row">
		<div class="col-12 d-flex justify-content-center align-items-center mt-3">
			<h2 class="text-center font-robotoSlab fw-bold color-2 m-0">Lobby Size</h2>
			<p class="infoIcon storeInfoIcon m-0" data-title="Lobby Size" data-info="Lobby size upgrades are permanent one-time purchases linked to your account. Once unlocked, any game you create can hold up to the upgraded player count. All players can join for free, only the game creator needs to own the upgrade.">&#9432;</p>
		</div>
	</div>

	<div class="row justify-content-center my-4">
		<div class="col-10 col-md-8">

			<!-- 100 Players -->
			<div class="row align-items-center mb-3 featureRow">
				<p class="col-5 mb-0 featureLabel">100 Players</p>
				<p class="col-3 mb-0 text-center featurePrice">$1.50</p>
				<div class="col-4 text-end">
					@if (Model.CurrentLobbySize >= MaxLobbySize.Medium)
					{
						<span class="ownedBadge">Owned</span>
					}
					else
					{
						<div id="paypal-btn-Lobby100"></div>
					}
				</div>
			</div>

			<!-- 150 Players -->
			<div class="row align-items-center mb-3 featureRow">
				<p class="col-5 mb-0 featureLabel">150 Players</p>
				<p class="col-3 mb-0 text-center featurePrice">$3.00</p>
				<div class="col-4 text-end">
					@if (Model.CurrentLobbySize >= MaxLobbySize.MediumLarge)
					{
						<span class="ownedBadge">Owned</span>
					}
					else
					{
						<div id="paypal-btn-Lobby150"></div>
					}
				</div>
			</div>

			<!-- 500 Players -->
			<div class="row align-items-center mb-3 featureRow">
				<p class="col-5 mb-0 featureLabel">500 Players</p>
				<p class="col-3 mb-0 text-center featurePrice">$6.00</p>
				<div class="col-4 text-end">
					@if (Model.CurrentLobbySize >= MaxLobbySize.Large)
					{
						<span class="ownedBadge">Owned</span>
					}
					else
					{
						<div id="paypal-btn-Lobby500"></div>
					}
				</div>
			</div>

			<!-- 10,000 Players -->
			<div class="row align-items-center mb-3 featureRow">
				<p class="col-5 mb-0 featureLabel">10,000 Players</p>
				<p class="col-3 mb-0 text-center featurePrice">$10.00</p>
				<div class="col-4 text-end">
					@if (Model.CurrentLobbySize >= MaxLobbySize.Max)
					{
						<span class="ownedBadge">Owned</span>
					}
					else
					{
						<div id="paypal-btn-Lobby10000"></div>
					}
				</div>
			</div>

		</div>
	</div>
</div>

<!-- ===== CARD 3: SUBSCRIPTION PLANS ===== -->
<div class="card glowingCard formBg mt-4 col-10 col-xl-11 mx-auto p-0 mb-5">
	<div class="card-header row">
		<div class="col-12 d-flex justify-content-center align-items-center mt-3">
			<h2 class="text-center font-robotoSlab fw-bold color-2 m-0">Subscription Plans</h2>
			<p class="infoIcon storeInfoIcon m-0" data-title="Subscription Plans" data-info="Subscription plans give you access to all game features and settings for as long as your subscription is active. Premium includes all settings with the default lobby size (50 players). Deluxe includes everything plus a max lobby size of 10,000 players. If your subscription ends, any features not purchased separately will be locked again.">&#9432;</p>
		</div>
	</div>

	<div class="row justify-content-center my-4">
		<div class="col-11 col-md-10">
			<div class="row justify-content-center">

				<!-- Standard Plan -->
				<div class="col-12 col-md-4 mb-4 mb-md-0">
					<div class="planCard text-center p-4">
						<h3 class="planName font-robotoSlab fw-bold">Standard</h3>
						<p class="planPriceMain">Free</p>
						<ul class="planFeatures text-start">
							<li>Default lobby (50 players)</li>
							<li>Basic game settings</li>
						</ul>
						@if (Model.CurrentPlan == Plan.Standard)
						{
							<span class="currentPlanBadge">Current Plan</span>
						}
						else
						{
							<button class="btn btn-1 subscribeBtn">Select</button>
						}
					</div>
				</div>

				<!-- Premium Plan -->
				<div class="col-12 col-md-4 mb-4 mb-md-0">
					<div class="planCard text-center p-4">
						<h3 class="planName font-robotoSlab fw-bold">Premium</h3>
						<p class="planPriceMain">$1.50 <span class="planPricePer">/ week</span></p>
						<p class="planPriceAlt">or $4.00 / month</p>
						<ul class="planFeatures text-start">
							<li>All settings unlocked</li>
							<li>Max lobby: 50 players</li>
						</ul>
						@if (Model.CurrentPlan == Plan.Premium)
						{
							<span class="currentPlanBadge">Current Plan</span>
						}
						else
						{
							<button class="btn btn-1 subscribeBtn">Subscribe</button>
						}
					</div>
				</div>

				<!-- Deluxe Plan -->
				<div class="col-12 col-md-4">
					<div class="planCard text-center p-4">
						<h3 class="planName font-robotoSlab fw-bold">Deluxe</h3>
						<p class="planPriceMain">$3.00 <span class="planPricePer">/ week</span></p>
						<p class="planPriceAlt">or $9.00 / month</p>
						<ul class="planFeatures text-start">
							<li>All settings unlocked</li>
							<li>Max lobby: 10,000 players</li>
						</ul>
						@if (Model.CurrentPlan == Plan.Deluxe)
						{
							<span class="currentPlanBadge">Current Plan</span>
						}
						else
						{
							<button class="btn btn-1 subscribeBtn">Subscribe</button>
						}
					</div>
				</div>

			</div>
		</div>
	</div>
</div>

<!-- ===== SHARED INFO MODAL ===== -->
<div class="modal fade" id="infoModal" role="dialog" tabindex="-1">
	<div class="modal-dialog" role="document">
		<div class="modal-content">
			<div class="modal-header justify-content-center">
				<h5 class="modal-title infoModalTitle">Info</h5>
				<button type="button" class="btn-close modalClose" data-bs-dismiss="modal" aria-label="Close"></button>
			</div>
			<div class="modal-body text-center">
				<p class="infoModalText">Info text goes here.</p>
			</div>
		</div>
	</div>
</div>
