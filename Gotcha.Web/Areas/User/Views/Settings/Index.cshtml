@using Gotcha.Web.Areas.User.ViewModels
@model UserSettingsViewModel

@{
	ViewData["Title"] = "User Settings";
}

<script src="~/js/shared/imageValidation.js"></script>
<script src="~/js/userSettingsPage.js"></script>

<div class="d-flex justify-content-center align-items-center mb-5">
		<h1 class="fw-bold font-bungee text-center">User Settings</h1>
		<p class="infoIcon settingsInfoIcon" data-title="User Settings" data-info="These are your account-wide settings. Changes here will apply to your profile across all games.">&#9432;</p>
	</div>

	@if (TempData["SuccessMessage"] != null)
	{
		<div class="alert alert-success text-center col-8 mx-auto mb-4">@TempData["SuccessMessage"]</div>
	}

	<form asp-action="Index" method="post" class="card glowingCard col-11 mx-auto formBg mb-5">
		@Html.AntiForgeryToken()
		<div class="card-header row">
			<div class="col-12 d-flex justify-content-center">
				<h2 class="text-center font-robotoSlab fw-bold mt-2 color-2 pt-2 pd-1">EDIT PROFILE</h2>
			</div>
		</div>
		<div class="card-body row mt-5 py-2">
			<div class="col-12 col-lg-6">
				<div class="row justify-content-center form-group">
					<label class="col-9 fw-bold color-2 mb-2 fs-6 font-roboto p-0" asp-for="FirstName">First Name:</label>
					<input class="col-9" asp-for="FirstName" type="text" placeholder="John" required />
					<span asp-validation-for="FirstName" class="text-danger col-9 p-0"></span>
				</div>
			</div>
			<div class="col-12 col-lg-6 mt-lg-0 mt-2">
				<div class="row justify-content-center form-group">
					<label class="col-9 fw-bold color-2 mb-2 fs-6 font-roboto p-0" asp-for="LastName">Last Name:</label>
					<input class="col-9" asp-for="LastName" type="text" placeholder="Doe" required />
					<span asp-validation-for="LastName" class="text-danger col-9 p-0"></span>
				</div>
			</div>
		</div>
		<div class="card-body row py-2">
			<div class="col-12 col-lg-6">
				<div class="row justify-content-center form-group">
					<label class="col-9 fw-bold color-2 mb-2 fs-6 font-roboto p-0" asp-for="UserName">Username:</label>
					<input class="col-9" asp-for="UserName" type="text" placeholder="TheLegend27" required />
					<span asp-validation-for="UserName" class="text-danger col-9 p-0"></span>
				</div>
			</div>
			<div class="col-12 col-lg-6">
				<div class="row justify-content-center form-group">
					<label class="col-9 fw-bold color-2 mb-2 fs-6 font-roboto p-0" asp-for="Email">Email Address:</label>
					<input class="col-9" asp-for="Email" type="text" placeholder="john.doe@example.com" required />
					<span asp-validation-for="Email" class="text-danger col-9 p-0"></span>
				</div>
			</div>
		</div>
		<div class="card-body row py-2">
			<div class="col-12 col-lg-6">
				<div class="row justify-content-center form-group">
					<label class="col-9 fw-bold color-2 mb-2 fs-6 font-roboto p-0" asp-for="BirthDate">Birthday:</label>
					<input class="col-9" asp-for="BirthDate" type="date" required />
					<span asp-validation-for="BirthDate" class="text-danger col-9 p-0"></span>
				</div>
			</div>
			<div class="col-12 col-lg-6">
				<div class="row justify-content-center">
					<label class="col-9 fw-bold color-2 mb-2 fs-6 font-roboto p-0" for="settingsImageInput">Picture:</label>
					<div class="row justify-content-center">
						<div class="col-10 align-items-end">
							<input id="settingsImageInput" type="file" accept="image/*" class="form-control" />
						</div>
					</div>
				</div>
			</div>
		</div>

		<div asp-validation-summary="ModelOnly" class="text-danger text-center"></div>

		<div class="row justify-content-center mt-5">
			<input type="submit" class="btn-1 col-4 col-lg-2 mb-2" value="Save Changes" />
		</div>

		<div class="row justify-content-center my-5 bottomLinks">
			<div class="col-10 col-md-11 col-xl-8 mt-2">
				<div class="justify-content-between align-items-center row">
					<p class="col-12 col-lg-8 text-nowrap text-center text-lg-start my-auto text-white">If you want to change your password you can reset it here:</p>
					<a class="col-12 col-lg-3 text-center my-auto">Reset Password</a>
				</div>
			</div>
			<div class="col-10 col-md-11 col-xl-8 mt-3">
				<div class="justify-content-between align-items-center row">
					<p class="col-12 col-lg-8 text-nowrap text-center text-lg-start my-auto text-white">If you want to unlock new features you can do so here:</p>
					<a asp-controller="Store" asp-action="Index" class="col-12 col-lg-3 text-center my-auto">Unlock Features</a>
				</div>
			</div>
		</div>
	</form>

<div class="modal fade" id="settingsInfoModal" role="dialog" tabindex="-1">
	<div class="modal-dialog" role="document">
		<div class="modal-content">
			<div class="modal-header justify-content-center">
				<h5 class="modal-title infoModalTitle">Info</h5>
				<button type="button" class="btn-close modalClose" data-bs-dismiss="modal" aria-label="Close"></button>
			</div>
			<div class="modal-body text-center">
				<p class="infoModalText">Info text goes here.</p>
			</div>
		</div>
	</div>
</div>
