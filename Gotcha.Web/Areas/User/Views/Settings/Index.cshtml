@{
	ViewData["Title"] = "User Settings";
}

<div class="d-flex justify-content-center align-items-center mb-5">
		<h1 class="fw-bold font-bungee text-center">User Settings</h1>
		<p class="infoIcon settingsInfoIcon" data-bs-toggle="modal" data-bs-target="#settingsInfoModal">&#9432;</p>
	</div>

	<form class="card glowingCard col-11 mx-auto formBg mb-5">
		<div class="card-header row">
			<div class="col-12 d-flex justify-content-center">
				<h2 class="text-center font-robotoSlab fw-bold mt-2 color-2 pt-2 pd-1">EDIT PROFILE</h2>
			</div>
		</div>
		<div class="card-body row mt-5 py-2">
			<div class="col-12 col-lg-6">
				<div class="row justify-content-center form-group">
					<label class="col-9 fw-bold color-2 mb-2 fs-6 font-roboto p-0" for="settingsFirstNameInput">First Name:</label>
					<input class="col-9" id="settingsFirstNameInput" type="text" placeholder="John" required />
				</div>
			</div>
			<div class="col-12 col-lg-6 mt-lg-0 mt-2">
				<div class="row justify-content-center form-group">
					<label class="col-9 fw-bold color-2 mb-2 fs-6 font-roboto p-0" for="settingsLastNameInput">Last Name:</label>
					<input class="col-9" id="settingsLastNameInput" type="text" placeholder="Doe" required />
				</div>
			</div>
		</div>
		<div class="card-body row py-2">
			<div class="col-12 col-lg-6">
				<div class="row justify-content-center form-group">
					<label class="col-9 fw-bold color-2 mb-2 fs-6 font-roboto p-0" for="settingsUsernameInput">Username:</label>
					<input class="col-9" id="settingsUsernameInput" type="text" placeholder="TheLegend27" required />
				</div>
			</div>
			<div class="col-12 col-lg-6">
				<div class="row justify-content-center form-group">
					<label class="col-9 fw-bold color-2 mb-2 fs-6 font-roboto p-0" for="settingsEmailInput">Email Address:</label>
					<input class="col-9" id="settingsEmailInput" type="text" placeholder="john.doe@example.com" required />
				</div>
			</div>
		</div>
		<div class="card-body row py-2">
			<div class="col-12 col-lg-6">
				<div class="row justify-content-center form-group">
					<label class="col-9 fw-bold color-2 mb-2 fs-6 font-roboto p-0" for="settingsBirthDayInput">Birthday:</label>
					<input class="col-9" id="settingsBirthDayInput" type="date" required />
				</div>
			</div>
			<div class="col-12 col-lg-6">
				<div class="row justify-content-center">
					<label class="col-9 fw-bold color-2 mb-2 fs-6 font-roboto p-0" for="settingsImageInput">Picture:</label>
					<div class="row justify-content-center">
						<div class="col-10 align-items-end">
							<input id="settingsImageInput" type="file" accept="image/*" class="form-control" />
						</div>
					</div>
				</div>
			</div>
		</div>
		<div class="row justify-content-center mt-5">
			<input type="submit" class="btn-1 col-4 col-lg-2 mb-2" value="Save Changes" />
		</div>

		<div class="row justify-content-center my-5 bottomLinks">
			<div class="col-10 col-md-11 col-xl-8 mt-2">
				<div class="justify-content-between align-items-center row">
					<p class="col-12 col-lg-8 text-nowrap text-center text-lg-start my-auto text-white">If you want to change your password you can reset it here:</p>
					<a class="col-12 col-lg-3 text-center my-auto">Reset Password</a>
				</div>
			</div>
			<div class="col-10 col-md-11 col-xl-8 mt-3">
				<div class="justify-content-between align-items-center row">
					<p class="col-12 col-lg-8 text-nowrap text-center text-lg-start my-auto text-white">If you want to unlock new features you can do so here:</p>
					<a asp-controller="Store" asp-action="Index" class="col-12 col-lg-3 text-center my-auto">Unlock Features</a>
				</div>
			</div>
		</div>
	</form>

<div class="modal fade" id="settingsInfoModal" role="dialog" tabindex="-1">
	<div class="modal-dialog" role="document">
		<div class="modal-content">
			<div class="modal-header justify-content-center">
				<h5 class="modal-title infoModalTitle">User Settings</h5>
				<button type="button" class="btn-close modalClose" data-bs-dismiss="modal" aria-label="Close"></button>
			</div>
			<div class="modal-body text-center">
				<p class="infoModalText">These are your account-wide settings. Changes here will apply to your profile across all games.</p>
			</div>
		</div>
	</div>
</div>
