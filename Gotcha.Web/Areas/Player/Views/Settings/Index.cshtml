@{
	ViewData["Title"] = "Player Settings";
}

@model Gotcha.Web.Areas.Player.ViewModels.PlayerSettingsViewModel

<div class="d-flex justify-content-center align-items-center mb-5">
	<h1 class="fw-bold font-bungee text-center">Player Settings</h1>
	<p class="infoIcon settingsInfoIcon" data-bs-toggle="modal" data-bs-target="#settingsInfoModal">&#9432;</p>
</div>

<form class="card glowingCard col-11 mx-auto formBg mb-5">
	<div class="card-header row">
		<div class="col-12 d-flex justify-content-center">
			<h2 class="text-center font-robotoSlab fw-bold mt-2 color-2 pt-2 pd-1">EDIT PLAYER PROFILE</h2>
		</div>
	</div>
	<div class="card-body row mt-5 py-2">
		<div class="col-12 col-lg-6">
			<div class="row justify-content-center form-group">
				<label class="col-9 fw-bold color-2 mb-2 fs-6 font-roboto p-0" for="settingsUsernameInput">Username:</label>
				<input class="col-9" id="settingsUsernameInput" type="text" placeholder="TheLegend27" value="@Model.Username" />
			</div>
		</div>
		<div class="col-12 col-lg-6 mt-lg-0 mt-2">
			<div class="row justify-content-center">
				<label class="col-9 fw-bold color-2 mb-2 fs-6 font-roboto p-0" for="settingsImageInput">Picture:</label>
				<div class="row justify-content-center">
					<div class="col-10 align-items-end">
						<input id="settingsImageInput" type="file" accept="image/*" class="form-control" />
					</div>
				</div>
			</div>
		</div>
	</div>

	@if (!String.IsNullOrEmpty(Model.ProfileImgSource))
	{
		<div class="row justify-content-center mt-4">
			<div class="col-6 col-md-4 col-lg-3 text-center">
				<p class="fw-bold color-2 mb-2 fs-6 font-roboto">Current Picture:</p>
				<img class="img-fluid rounded-circle currentImage" alt="Current player image" src="@Model.ProfileImgSource" />
			</div>
		</div>
	}

	<div class="row justify-content-center mt-5">
		<input type="submit" class="btn-1 col-4 col-lg-2 mb-2" value="Save Changes" />
	</div>
</form>

<div class="modal fade" id="settingsInfoModal" role="dialog" tabindex="-1">
	<div class="modal-dialog" role="document">
		<div class="modal-content">
			<div class="modal-header justify-content-center">
				<h5 class="modal-title infoModalTitle">Player Settings</h5>
				<button type="button" class="btn-close modalClose" data-bs-dismiss="modal" aria-label="Close"></button>
			</div>
			<div class="modal-body text-center">
				<p class="infoModalText">These settings only apply to the game you are currently in. Changes here won't affect your main profile or any other games.</p>
			</div>
		</div>
	</div>
</div>
