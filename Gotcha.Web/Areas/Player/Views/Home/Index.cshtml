@using Gotcha.Core.Enums;
@using Gotcha.Web.Areas.Player.ViewModels.BaseViewModels;

@{
	ViewData["Title"] = "Player Home";
}

<script src="~/js/playerHome.js"></script>

@model Gotcha.Web.Areas.Player.ViewModels.HomeViewModel

@if(ViewData["IsAlive"] is true)
{
	<div class="row mb-3">
		<h1 class="col-12 text-center fw-bold font-bungee">Status:</h1>
	</div>

	@if (!String.IsNullOrEmpty(Model.TargetName))
	{
		<div class="card glowingCard formBg mt-4 col-10 col-xl-11 mx-auto p-0 mb-5">
			<div class="card-header row">
				<h2 class="col-12 text-center font-robotoSlab fw-bold color-2 mt-3">Current Target:</h2>
			</div>
			<div class="row justify-content-center">
				@if (!String.IsNullOrEmpty(Model.TargetProfileImgSource))
				{
					<img class="img-fluid rounded-circle playerImage col-6 col-sm-5 col-md-4 col-lg-3 my-4" alt="placeholder image" src="@Model.TargetProfileImgSource" />
				}
				else
				{
					switch (Model.TargetGender)
					{
						case Genders.Male:
							<img class="img-fluid rounded-circle targetImage col-6 col-sm-5 col-md-4 col-lg-3 my-4" alt="Male placeholder image" src="~/images/male-placeholder.png" />
							break;
						case Genders.Female:
							<img class="img-fluid rounded-circle targetImage col-6 col-sm-5 col-md-4 col-lg-3 my-4" alt="Female placeholder image" src="~/images/female-placeholder.png" />
							break;
						default:
							<img class="img-fluid rounded-circle targetImage col-6 col-sm-5 col-md-4 col-lg-3 my-4" alt="Other gender placeholder image" src="~/images/other-placeholder.png" />
							break;
					}
				}
			</div>
			<div class="row justify-content-center">
				<div class="col-10 col-md-9 col-xl-7 statsBlocksContainer mb-5">

					@if (!String.IsNullOrEmpty(Model.TargetName))
					{
						<div class="row justify-content-around align-items-center my-3 statBlock">
							<p class="col-12 col-lg-5 text-center text-lg-start fs-3 text-nowrap m-0 fw-bold">Target Name:</p>
							<p class="col-12 col-lg-5 text-center text-lg-end fs-4 my-0 text-nowrap">@Model.TargetName</p>
						</div>
					}

					@if (!String.IsNullOrEmpty(Model.TargetUsername))
					{
						<div class="row justify-content-around align-items-center my-3 statBlock">
							<p class="col-12 col-lg-5 text-center text-lg-start fs-3 text-nowrap m-0 fw-bold">Target Username:</p>
							<p class="col-12 col-lg-5 text-center text-lg-end fs-4 my-0 text-nowrap">@Model.TargetUsername</p>
						</div>
					}

					@if (!String.IsNullOrEmpty(Model.Weapon))
					{
						<div class="row justify-content-around align-items-center my-3 statBlock">
							<p class="col-12 col-lg-5 text-center text-lg-start fs-3 text-nowrap m-0 fw-bold">Weapon:</p>
							<p class="col-12 col-lg-5 text-center text-lg-end fs-4 my-0 text-nowrap">@Model.Weapon</p>
						</div>
					}

					@if (Model.AssignmentExpirationDate != null)
					{
						TimeSpan timeDifference = (TimeSpan)(Model.AssignmentExpirationDate - DateTime.UtcNow);

						if (timeDifference.TotalSeconds > 0)
						{
						int dd = timeDifference.Days; // days difference
						int hd = timeDifference.Hours; // hours difference
						int md = timeDifference.Minutes; // minutes difference
						int sd = timeDifference.Seconds; // seconds difference

						<div class="row justify-content-center mt-1">
							<p class="col-12 text-center fs-3 text-nowrap my-0 fw-bold">Time Left:</p>
							<div class="col-11 col-md-9 col-xl-8 text-center fs-lg-3 p-0 my-0">
								<div class="row text-center text-nowrap mt-3">
									<p class="col-3 my-0 fs-6" id="dayTimer">@dd</p>
									<p class="col-3 my-0 fs-6" id="hourTimer">@hd</p>
									<p class="col-3 my-0 fs-6 " id="minuteTimer">@md</p>
									<p class="col-3 my-0 fs-6" id="secondTimer">@sd</p>
								</div>
								<div class="row text-center text-nowrap">
									<p class="col-3 fs-5">Days</p>
									<p class="col-3 fs-5">Hours</p>
									<p class="col-3 fs-5">Minutes</p>
									<p class="col-3 fs-5">Seconds</p>
								</div>
							</div>
						</div>
						}
					}

				</div>
			</div>
		</div>
	}
}

<div class="card glowingCard formBg mt-4 col-10 col-xl-11 mx-auto p-0 mb-5">
	<div class="card-header row">
		<h2 class="col-12 text-center font-robotoSlab fw-bold color-2 mt-3">Game Stats:</h2>
	</div>

	<div class="row justify-content-center">
		@if (!String.IsNullOrEmpty(Model.PlayerProfileImgSource))
		{
			<img class="img-fluid rounded-circle playerImage col-6 col-sm-5 col-md-4 col-lg-3 my-4" alt="placeholder image" src="@Model.PlayerProfileImgSource" />
		}
		else
		{
			switch (Model.PlayerGender)
			{
				case Genders.Male:
					<img class="img-fluid rounded-circle targetImage col-6 col-sm-5 col-md-4 col-lg-3 my-4" alt="Male placeholder image" src="~/images/male-placeholder.png" />
					break;
				case Genders.Female:
					<img class="img-fluid rounded-circle targetImage col-6 col-sm-5 col-md-4 col-lg-3 my-4" alt="Female placeholder image" src="~/images/female-placeholder.png" />
					break;
				default:
					<img class="img-fluid rounded-circle targetImage col-6 col-sm-5 col-md-4 col-lg-3 my-4" alt="Other gender placeholder image" src="~/images/other-placeholder.png" />
					break;
			}
		}

		<div class="col-12 mt-2">
			<div class="row justify-content-center">
				<div class="col-10 col-md-9 col-xl-7 statsBlocksContainer">

					<div class="row justify-content-around align-items-center my-3 statBlock">
						<p class="col-12 col-lg-5 text-center text-lg-start fs-3 text-nowrap m-0 fw-bold">Game Started:</p>
						<p class="col-12 col-lg-5 text-center text-lg-end fs-4 text-nowrap my-0">@Model.StartDate.ToString("dd-MM-yyyy - HH:mm")</p>
					</div>

					@if(Model.EndDate != null)
					{
						DateTime endDate = (DateTime)Model.EndDate;

						<div class="row justify-content-around align-items-center my-3 statBlock">
							<p class="col-12 col-lg-5 text-center text-lg-start fs-3 text-nowrap m-0 fw-bold">Game Ended:</p>
							<p class="col-12 col-lg-5 text-center text-lg-end fs-4 text-nowrap my-0">@endDate.ToString("dd-MM-yyyy - HH:mm")</p>
						</div>
					}

					@if (!String.IsNullOrEmpty(Model.WinnerName))
					{
						<div class="row justify-content-around align-items-center my-3 statBlock nameBlock">
							<p class="col-6 col-lg-5 text-center text-lg-start text-nowrap m-0 fw-bold order-1 order-lg-1 smallBorderRight">Winner:</p>
							<p class="col-6 col-lg-5 text-center text-lg-end text-nowrap my-0 order-3 order-lg-2 smallBorderRight">@Model.WinnerName</p>
							@if (!String.IsNullOrEmpty(Model.WinnerOtherName))
							{
								<p class="col-6 col-lg-5 text-center text-lg-start text-nowrap m-0 fw-bold order-2 order-lg-3">A.K.A.:</p>
								<p class="col-6 col-lg-5 text-center text-lg-end text-nowrap my-0 order-4 order-lg-4">@Model.WinnerOtherName</p>
							}
						</div>
					}

					@if (Model.KilledOnDate != null)
					{
						DateTime killedOn = (DateTime)Model.KilledOnDate;

						<div class="row justify-content-around align-items-center my-3 statBlock">
							<p class="col-12 col-lg-5 text-center text-lg-start fs-3 text-nowrap m-0 fw-bold">Killed On:</p>
							<p class="col-12 col-lg-5 text-center text-lg-end fs-4 text-nowrap my-0">@killedOn.ToString("dd-MM-yyyy - HH:mm")</p>
						</div>
					}

					@if (!String.IsNullOrEmpty(Model.KillerName))
					{
						<div class="row justify-content-around align-items-center my-3 statBlock nameBlock" id="winnerStatBlock">
							<p class="col-6 col-lg-5 text-center text-lg-start text-nowrap m-0 fw-bold order-1 order-lg-1 smallBorderRight">Killed By (player):</p>
							<p class="col-6 col-lg-5 text-center text-lg-end text-nowrap my-0 order-3 order-lg-2 smallBorderRight">@Model.KillerName</p>
							@if (!String.IsNullOrEmpty(Model.KillerOtherName))
							{
								<p class="col-6 col-lg-5 text-center text-lg-start text-nowrap m-0 fw-bold order-2 order-lg-3">A.K.A.:</p>
								<p class="col-6 col-lg-5 text-center text-lg-end text-nowrap my-0 order-4 order-lg-4">@Model.KillerOtherName</p>
							}
						</div>
					}

					@if (!String.IsNullOrEmpty(Model.Weapon))
					{
						<div class="row justify-content-around align-items-center my-3 statBlock">
							<p class="col-12 col-lg-5 text-center text-lg-start fs-3 text-nowrap m-0 fw-bold">Killed by (weapon):</p>
							<p class="col-12 col-lg-5 text-center text-lg-end fs-4 text-nowrap my-0">@Model.Weapon</p>
						</div>
					}

					@if (Model.Kills != null)
					{
						<div class="row justify-content-around align-items-center my-3 statBlock">
							<p class="col-12 col-lg-5 text-center text-lg-start fs-3 text-nowrap m-0 fw-bold">Kills:</p>
							<p class="col-12 col-lg-5 text-center text-lg-end fs-4 text-nowrap my-0">@Model.Kills.Count()</p>
						</div>
					}
				</div>


				@if(Model.Kills != null && Model.Kills.Count() != 0)
				{
					<h3 class="col-12 text-center font-robotoSlab fw-bold color-1" id="killOverviewTitle">KILLS OVERVIEW:</h3>
					<div class="col-10 col-lg-11 mb-5 killInfoTable">
						<div class="row justify-content-around align-items-center killInfoTableHeader">
							<p class="col-3 mt-2 mb-1 text-nowrap text-center">Full Name:</p>
							<p class="col-3 mt-2 mb-1 text-nowrap text-center">Username:</p>
							<p class="col-3 mt-2 mb-1 text-nowrap text-center">Weapon:</p>
							<p class="col-3 mt-2 mb-1 text-nowrap text-center">TimeStamp:</p>
						</div>
						@foreach (KillBaseViewModel kill in Model.Kills)
						{
							DateTime timestamp = kill.TimeStamp;
							timestamp = timestamp.ToLocalTime();
							string formatted = timestamp.ToString("dd-MM-yyyy - HH:mm");

							<div class="killInfoBlock row justify-content-around align-items-center">
								<p class="col-3 my-2 text-nowrap text-center killInfo">@kill.VictimFullName</p>

								@if (!String.IsNullOrEmpty(kill.VictimUsername))
								{
									<p class="col-3 my-2 text-nowrap text-center killInfo">@kill.VictimUsername</p>
								}


								@if (!String.IsNullOrEmpty(kill.Weapon))
								{
									<p class="col-3 my-2 text-nowrap text-center killInfo">@kill.Weapon</p>
								}

								<p class="col-3 my-2 text-nowrap text-center killInfo killTimeInfo">@formatted</p>
							</div>
							}
						</div>
				}
			</div>
		</div>
	</div>
</div>