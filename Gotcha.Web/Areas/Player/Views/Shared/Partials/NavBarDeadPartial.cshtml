<header>
    <nav class="noSelect bigScreenNav">
        <div class="row maxWidth100">
            <div class="col-12 col-xl-11">
                <ul class="row align-items-center justify-content-between">
                    <li class="col-2">
                        <span class="navLogoBackground navLogoBackgroundBigScreen"></span>
                        <figure class="navLogoContainer clickAble">
                            <img class="navLogoImage img-fluid" src="~/images/logoFullPng.png" />
                            <figcaption class="navLogoText font-nosifer">GOTCHA</figcaption>
                        </figure>
                    </li>
                    <li class="col-8 col-lg-9 pt-5 mt-3">
                        <ul class="row justify-content-around">
                            <li class="col-2 text-center fw-bold fs-4 font-robotoSlab text-nowrap"><a asp-controller="Home" asp-action="Index">Match Results</a></li>
                            <li class="col-2 text-center fw-bold fs-4 font-robotoSlab text-nowrap"><a asp-controller="Settings" asp-action="Index">Player Settings</a></li>
                            @if(ViewData["IsAdmin"] is true)
                            {
                                <li class="col-2 text-center fw-bold fs-4 font-robotoSlab text-nowrap"><a asp-controller="Admin" asp-action="Index">Admin</a></li>
                            }
                        </ul>
                    </li>
                </ul>
            </div>
        </div>
    </nav>

    <nav class="noSelect smallScreenNav">
        <ul class="row align-items-center justify-content-between">
            <li class="col-8 justify-content-center d-flex">
                <figure class="navLogoBackground clickAble d-flex flex-row align-items-center justify-content-between row">
                    <img class="img-fluid col-5" src="~/images/logoFullPng.png" />
                    <figcaption class="col-7 font-nosifer">GOTCHA</figcaption>
                </figure>
            </li>
            <li class="col-3 pb-3">
                <div class="menuContainer">
                    <div class="bar1"></div>
                    <div class="bar2"></div>
                    <div class="bar3"></div>
                </div>
            </li>
        </ul>
    </nav>
</header>

<div class="menuOpenNavContainer">
    <div class="row justify-content-center menuOpenNav mx-auto">
        <div class="col-10">
            <ul class="row card glowingCard p-0 mt-4">
                <li class="col-12 my-4 py-4"><a asp-controller="Home" asp-action="Index">Match Results</a></li>
                <li class="col-12 my-4 py-4"><a asp-controller="Settings" asp-action="Index">Player Settings</a></li>
                <li class="col-12 my-4 py-4"><a asp-controller="Admin" asp-action="Index">Admin</a></li>
            </ul>
        </div>
    </div>
</div>
