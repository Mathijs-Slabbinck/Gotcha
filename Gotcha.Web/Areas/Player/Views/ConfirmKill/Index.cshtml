@using Gotcha.Core.Enums;

@{
	ViewData["Title"] = "Confirm Kill";
}

@model Gotcha.Web.Areas.Player.ViewModels.ConfirmKillViewModel

<div class="row mb-3">
	<h1 class="col-12 text-center">Confirm Kill</h1>
</div>

@* ===== CARD 1: I Killed My Target ===== *@
@if (!String.IsNullOrEmpty(Model.TargetName) || !String.IsNullOrEmpty(Model.TargetUsername))
{
	<div class="card glowingCard formBg mt-4 col-10 col-xl-11 mx-auto p-0 mb-5">
		<div class="card-header row">
			<h2 class="col-12 text-center font-robotoSlab fw-bold color-2 mt-3">I Killed My Target</h2>
		</div>

		<div class="row justify-content-center">
			@if (!String.IsNullOrEmpty(Model.TargetProfileImgSource))
			{
				<img class="img-fluid rounded-circle playerImage col-6 col-sm-5 col-md-4 col-lg-3 my-4" alt="Target profile image" src="@Model.TargetProfileImgSource" />
			}
			else
			{
				switch (Model.TargetGender)
				{
					case Genders.Male:
						<img class="img-fluid rounded-circle playerImage col-6 col-sm-5 col-md-4 col-lg-3 my-4" alt="Male placeholder image" src="~/images/male-placeholder.png" />
						break;
					case Genders.Female:
						<img class="img-fluid rounded-circle playerImage col-6 col-sm-5 col-md-4 col-lg-3 my-4" alt="Female placeholder image" src="~/images/female-placeholder.png" />
						break;
					default:
						<img class="img-fluid rounded-circle playerImage col-6 col-sm-5 col-md-4 col-lg-3 my-4" alt="Other gender placeholder image" src="~/images/other-placeholder.png" />
						break;
				}
			}
		</div>

		<div class="row justify-content-center">
			<div class="col-10 col-md-9 col-xl-7 statsBlocksContainer mb-4">

				@if (!String.IsNullOrEmpty(Model.TargetName))
				{
					<div class="row justify-content-around align-items-center my-3 statBlock">
						<p class="col-12 col-lg-5 text-center text-lg-start fs-3 text-nowrap m-0 fw-bold">Target:</p>
						<p class="col-12 col-lg-5 text-center text-lg-end fs-4 my-0 text-nowrap">@Model.TargetName</p>
					</div>
				}

				@if (!String.IsNullOrEmpty(Model.TargetUsername))
				{
					<div class="row justify-content-around align-items-center my-3 statBlock">
						<p class="col-12 col-lg-5 text-center text-lg-start fs-3 text-nowrap m-0 fw-bold">Username:</p>
						<p class="col-12 col-lg-5 text-center text-lg-end fs-4 my-0 text-nowrap">@Model.TargetUsername</p>
					</div>
				}

				@if (!String.IsNullOrEmpty(Model.Weapon))
				{
					<div class="row justify-content-around align-items-center my-3 statBlock">
						<p class="col-12 col-lg-5 text-center text-lg-start fs-3 text-nowrap m-0 fw-bold">Weapon:</p>
						<p class="col-12 col-lg-5 text-center text-lg-end fs-4 my-0 text-nowrap">@Model.Weapon</p>
					</div>
				}
			</div>
		</div>

		<div class="row justify-content-center mb-4">
			<button class="col-8 col-md-6 col-lg-4 btn-1 fs-5 py-2 confirmButton">Confirm Kill</button>
		</div>
	</div>
}

@* ===== CARD 2: I Got Killed ===== *@
<div class="card glowingCard formBg mt-4 col-10 col-xl-11 mx-auto p-0 mb-5">
	<div class="card-header row">
		<h2 class="col-12 text-center font-robotoSlab fw-bold color-2 mt-3">I Got Killed</h2>
	</div>

	<div class="row justify-content-center">
		<div class="col-10 col-md-9 col-xl-7 mb-4 mt-3">
			<p class="text-center fs-5 confirmDescription">
				If you have been eliminated, confirm your death here.
				Your hunter will need to confirm the kill on their side as well.
			</p>
		</div>
	</div>

	<div class="row justify-content-center mb-4">
		<button class="col-8 col-md-6 col-lg-4 btn-1 fs-5 py-2 confirmButton deathButton">Confirm Death</button>
	</div>
</div>

@* ===== CARD 3: I Killed My Hunter (Assassin Mode Only) ===== *@
@if (Model.IsAssassinMode)
{
	<div class="card glowingCard formBg mt-4 col-10 col-xl-11 mx-auto p-0 mb-5">
		<div class="card-header row">
			<h2 class="col-12 text-center font-robotoSlab fw-bold color-2 mt-3">I Killed My Hunter</h2>
		</div>

		<div class="row justify-content-center">
			@if (!String.IsNullOrEmpty(Model.HunterProfileImgSource))
			{
				<img class="img-fluid rounded-circle playerImage col-6 col-sm-5 col-md-4 col-lg-3 my-4" alt="Hunter profile image" src="@Model.HunterProfileImgSource" />
			}
			else
			{
				switch (Model.HunterGender)
				{
					case Genders.Male:
						<img class="img-fluid rounded-circle playerImage col-6 col-sm-5 col-md-4 col-lg-3 my-4" alt="Male placeholder image" src="~/images/male-placeholder.png" />
						break;
					case Genders.Female:
						<img class="img-fluid rounded-circle playerImage col-6 col-sm-5 col-md-4 col-lg-3 my-4" alt="Female placeholder image" src="~/images/female-placeholder.png" />
						break;
					default:
						<img class="img-fluid rounded-circle playerImage col-6 col-sm-5 col-md-4 col-lg-3 my-4" alt="Other gender placeholder image" src="~/images/other-placeholder.png" />
						break;
				}
			}
		</div>

		<div class="row justify-content-center">
			<div class="col-10 col-md-9 col-xl-7 statsBlocksContainer mb-4">

				@if (!String.IsNullOrEmpty(Model.HunterName))
				{
					<div class="row justify-content-around align-items-center my-3 statBlock">
						<p class="col-12 col-lg-5 text-center text-lg-start fs-3 text-nowrap m-0 fw-bold">Hunter:</p>
						<p class="col-12 col-lg-5 text-center text-lg-end fs-4 my-0 text-nowrap">@Model.HunterName</p>
					</div>
				}

				@if (!String.IsNullOrEmpty(Model.HunterUsername))
				{
					<div class="row justify-content-around align-items-center my-3 statBlock">
						<p class="col-12 col-lg-5 text-center text-lg-start fs-3 text-nowrap m-0 fw-bold">Username:</p>
						<p class="col-12 col-lg-5 text-center text-lg-end fs-4 my-0 text-nowrap">@Model.HunterUsername</p>
					</div>
				}
			</div>
		</div>

		<div class="row justify-content-center mb-4">
			<p class="col-10 text-center fs-6 confirmDescription">
				In Assassin mode, you can turn the tables on your hunter.
				If you figured out who was hunting you and eliminated them, confirm it here.
			</p>
			<button class="col-8 col-md-6 col-lg-4 btn-1 fs-5 py-2 confirmButton assassinButton">Confirm Hunter Kill</button>
		</div>
	</div>
}
