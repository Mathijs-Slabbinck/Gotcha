<?xml version="1.0" encoding="UTF-8" ?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit">

    <toolkit:InvertedBoolConverter x:Key="InvertBoolConverter" />
    <toolkit:IsStringNotNullOrEmptyConverter x:Key="IsStringNotNullOrEmptyConverter" />
    <toolkit:IsNotNullConverter x:Key="IsNotNullConverter" />

    <toolkit:BoolToObjectConverter x:Key="BoolToSuccessDangerColorConverter"
        TrueObject="{StaticResource Success}"
        FalseObject="{StaticResource Danger}" />
    <toolkit:BoolToObjectConverter x:Key="AliveStatusTextConverter"
        TrueObject="Alive"
        FalseObject="Dead" />
    <toolkit:BoolToObjectConverter x:Key="YesNoTextConverter"
        TrueObject="Yes"
        FalseObject="No" />
    <toolkit:BoolToObjectConverter x:Key="PasswordVisibilityIconConverter"
        TrueObject="eye_open.svg"
        FalseObject="eye_closed.svg" />

</ResourceDictionary>