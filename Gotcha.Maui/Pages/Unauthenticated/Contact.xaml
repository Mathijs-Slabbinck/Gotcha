<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:Gotcha.Maui.ViewModels"
             x:DataType="viewmodels:ContactViewModel"
             x:Class="Gotcha.Maui.Pages.Unauthenticated.Contact"
             Title="Contact"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{StaticResource OffBlack}">

    <ScrollView>
        <VerticalStackLayout Spacing="0" VerticalOptions="Center" Padding="0,30,0,0">

            <!-- CONTACT title -->
            <Label Text="CONTACT"
                   TextColor="{StaticResource Primary}"
                   FontSize="22"
                   FontAttributes="Bold"
                   HorizontalTextAlignment="Center"
                   FontFamily="Bungee"
                   Margin="0,0,0,25" />

            <!-- Contact form card (white background) -->
            <Border BackgroundColor="{StaticResource CardBackground}"
                    StrokeShape="RoundRectangle 12"
                    Stroke="{StaticResource Secondary}"
                    StrokeThickness="0"
                    Margin="20,0"
                    Padding="0">
                <Border.Shadow>
                    <Shadow Brush="{StaticResource PrimaryBrush}"
                            Offset="0,0"
                            Radius="20"
                            Opacity="0.4" />
                </Border.Shadow>

                <VerticalStackLayout Spacing="0">

                    <!-- Card header -->
                    <Border BackgroundColor="{StaticResource CardBackground}"
                            StrokeThickness="0"
                            StrokeShape="RoundRectangle 12,12,0,0"
                            Padding="0,14">
                        <Label Text="CONTACT US"
                               TextColor="{StaticResource Tertiary}"
                               FontSize="20"
                               FontAttributes="Bold"
                               FontFamily="RobotoSlab"
                               HorizontalTextAlignment="Center" />
                    </Border>

                    <!-- Separator under header -->
                    <BoxView HeightRequest="1"
                             BackgroundColor="{StaticResource Gray200}"
                             HorizontalOptions="Fill" />

                    <!-- Form content -->
                    <VerticalStackLayout Padding="30,20" Spacing="5">

                        <!-- Reason label -->
                        <Label Text="Reason for contact:"
                               TextColor="{StaticResource Secondary}"
                               FontAttributes="Bold"
                               HorizontalTextAlignment="Center"
                               Margin="0,0,0,5" />

                        <!-- Reason picker -->
                        <Border Stroke="{StaticResource Secondary}"
                                StrokeThickness="2"
                                StrokeShape="RoundRectangle 4"
                                Padding="8,0"
                                BackgroundColor="{StaticResource White}"
                                HorizontalOptions="Fill">
                            <Picker ItemsSource="{Binding Reasons}"
                                    SelectedItem="{Binding SelectedReason}"
                                    Title="Select an option"
                                    TitleColor="{StaticResource Gray400}"
                                    TextColor="{StaticResource Gray900}"
                                    HorizontalTextAlignment="Center"
                                    AutomationId="ReasonPicker" />
                        </Border>

                        <!-- Message label -->
                        <Label Text="Message:"
                               TextColor="{StaticResource Secondary}"
                               FontAttributes="Bold"
                               HorizontalTextAlignment="Center"
                               Margin="0,15,0,5" />

                        <!-- Message input -->
                        <Border Stroke="{StaticResource Secondary}"
                                StrokeThickness="2"
                                StrokeShape="RoundRectangle 4"
                                Padding="8,4"
                                BackgroundColor="{StaticResource White}"
                                HorizontalOptions="Fill">
                            <Editor Text="{Binding Message}"
                                    Placeholder="Type your message here..."
                                    PlaceholderColor="{StaticResource Gray400}"
                                    TextColor="{StaticResource Gray900}"
                                    BackgroundColor="Transparent"
                                    HeightRequest="160"
                                    MaxLength="4000"
                                    AutomationId="MessageEditor" />
                        </Border>

                        <!-- Error message -->
                        <Label Text="{Binding ErrorMessage}"
                               TextColor="{StaticResource Danger}"
                               HorizontalTextAlignment="Center"
                               IsVisible="{Binding ErrorMessage, Converter={StaticResource IsStringNotNullOrEmptyConverter}}"
                               Margin="0,5,0,0"
                               AutomationId="ErrorMessageLabel" />

                        <!-- Success message -->
                        <Label Text="{Binding SuccessMessage}"
                               TextColor="{StaticResource Tertiary}"
                               HorizontalTextAlignment="Center"
                               IsVisible="{Binding SuccessMessage, Converter={StaticResource IsStringNotNullOrEmptyConverter}}"
                               Margin="0,5,0,0"
                               AutomationId="SuccessMessageLabel" />

                        <!-- Submit button -->
                        <Button Text="Submit"
                                Command="{Binding SubmitCommand}"
                                IsEnabled="{Binding IsBusy, Converter={StaticResource InvertBoolConverter}}"
                                HorizontalOptions="Center"
                                WidthRequest="220"
                                Margin="0,10,0,0"
                                AutomationId="SubmitButton" />

                    </VerticalStackLayout>
                </VerticalStackLayout>
            </Border>

            <!-- Ready to play section (cyan background) -->
            <Border BackgroundColor="{StaticResource Primary}"
                    StrokeThickness="0"
                    StrokeShape="RoundRectangle 12"
                    Margin="20,25,20,30"
                    Padding="25,20">

                <VerticalStackLayout Spacing="8">

                    <Label Text="READY TO PLAY?"
                           TextColor="White"
                           FontSize="20"
                           FontAttributes="Bold"
                           FontFamily="RobotoSlab"
                           HorizontalTextAlignment="Center" />

                    <Label Text="Sign in or create an account to get started."
                           TextColor="White"
                           FontAttributes="Bold"
                           FontSize="14"
                           HorizontalTextAlignment="Center"
                           Margin="0,10,0,0" />

                    <!-- Back to Sign In button -->
                    <Button Text="Back to Sign In"
                            Style="{StaticResource SecondaryButton}"
                            HorizontalOptions="Center"
                            WidthRequest="220"
                            Margin="0,10,0,0"
                            Command="{Binding GoBackCommand}"
                            AutomationId="BackToSignInButton" />

                </VerticalStackLayout>
            </Border>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
