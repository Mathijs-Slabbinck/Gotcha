<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:Gotcha.Maui.ViewModels"
             x:DataType="viewmodels:SignInViewModel"
             x:Class="Gotcha.Maui.Pages.Unauthenticated.SignIn"
             Title="Sign In"
             Shell.NavBarIsVisible="False">

    <ScrollView>
        <VerticalStackLayout Padding="30,50,30,30" Spacing="10" VerticalOptions="Center">

            <!-- Title -->
            <Label Text="SIGN IN"
                   FontSize="28"
                   FontAttributes="Bold"
                   HorizontalTextAlignment="Center"
                   Margin="0,0,0,20" />

            <!-- Username / Email -->
            <Label Text="Username / Email:"
                   FontAttributes="Bold"
                   HorizontalTextAlignment="Center" />

            <Entry Text="{Binding UsernameOrEmail}"
                   Placeholder="john.doe@example.com"
                   Keyboard="Email"
                   HorizontalTextAlignment="Center"
                   MaxLength="254"
                   ReturnType="Next" />

            <!-- Password -->
            <Label Text="Password:"
                   FontAttributes="Bold"
                   HorizontalTextAlignment="Center"
                   Margin="0,10,0,0" />

            <Grid ColumnDefinitions="*,Auto">
                <Entry Grid.Column="0"
                       Text="{Binding Password}"
                       Placeholder="password"
                       IsPassword="{Binding IsPasswordVisible, Converter={StaticResource InvertBoolConverter}}"
                       HorizontalTextAlignment="Center"
                       MaxLength="128"
                       ReturnType="Done" />

                <ImageButton Grid.Column="1"
                             Command="{Binding TogglePasswordVisibilityCommand}"
                             WidthRequest="44"
                             HeightRequest="44"
                             BackgroundColor="Transparent"
                             Padding="8">
                    <ImageButton.Source>
                        <FontImageSource FontFamily="OpenSansRegular"
                                         Glyph="&#x1F441;"
                                         Size="20" />
                    </ImageButton.Source>
                </ImageButton>
            </Grid>

            <!-- Remember me -->
            <HorizontalStackLayout HorizontalOptions="Center" Spacing="5" Margin="0,5,0,0">
                <CheckBox IsChecked="{Binding RememberMe}" VerticalOptions="Center" />
                <Label Text="Remember me" VerticalOptions="Center" />
            </HorizontalStackLayout>

            <!-- Error message -->
            <Label Text="{Binding ErrorMessage}"
                   TextColor="Red"
                   HorizontalTextAlignment="Center"
                   IsVisible="{Binding ErrorMessage, Converter={StaticResource IsStringNotNullOrEmptyConverter}}" />

            <!-- Sign in button -->
            <Button Text="log in"
                    Command="{Binding SignInCommand}"
                    HorizontalOptions="Center"
                    WidthRequest="200"
                    Margin="0,15,0,0" />

            <!-- Forgot password -->
            <Label Text="Forgot password?"
                   TextColor="{StaticResource Primary}"
                   TextDecorations="Underline"
                   HorizontalTextAlignment="Center"
                   Margin="0,5,0,0">
                <Label.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding ForgotPasswordCommand}" />
                </Label.GestureRecognizers>
            </Label>

            <!-- Separator -->
            <BoxView HeightRequest="1"
                     Margin="0,20,0,10"
                     HorizontalOptions="Fill" />

            <!-- Sign up section -->
            <Label Text="Don't have an account yet?"
                   HorizontalTextAlignment="Center" />

            <Label Text="sign up"
                   TextColor="{StaticResource Primary}"
                   TextDecorations="Underline"
                   FontAttributes="Bold"
                   HorizontalTextAlignment="Center">
                <Label.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding SignUpCommand}" />
                </Label.GestureRecognizers>
            </Label>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
