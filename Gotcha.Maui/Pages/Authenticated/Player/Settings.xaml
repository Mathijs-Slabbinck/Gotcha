<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:Gotcha.Maui.ViewModels"
             x:DataType="viewmodels:PlayerSettingsViewModel"
             x:Class="Gotcha.Maui.Pages.Authenticated.Player.Settings"
             Title="Settings"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{StaticResource OffBlack}">

    <ScrollView>
        <VerticalStackLayout Spacing="0" Padding="0,30,0,0">

            <!-- PLAYER SETTINGS heading -->
            <Label Text="PLAYER SETTINGS"
                   TextColor="{StaticResource Primary}"
                   FontSize="22"
                   FontAttributes="Bold"
                   HorizontalTextAlignment="Center"
                   FontFamily="Bungee"
                   Margin="0,0,0,25"
                   SemanticProperties.HeadingLevel="Level1" />

            <!-- Edit Profile card -->
            <Border BackgroundColor="{StaticResource CardBackground}"
                    StrokeShape="RoundRectangle 12"
                    StrokeThickness="0"
                    Margin="20,0"
                    Padding="0">
                <Border.Shadow>
                    <Shadow Brush="{StaticResource PrimaryBrush}"
                            Offset="0,0"
                            Radius="20"
                            Opacity="0.4" />
                </Border.Shadow>

                <VerticalStackLayout Spacing="0">

                    <Border BackgroundColor="{StaticResource CardBackground}"
                            StrokeThickness="0"
                            StrokeShape="RoundRectangle 12,12,0,0"
                            Padding="0,14">
                        <Label Text="EDIT PROFILE"
                               TextColor="{StaticResource Tertiary}"
                               FontSize="20"
                               FontAttributes="Bold"
                               FontFamily="RobotoSlab"
                               HorizontalTextAlignment="Center"
                               SemanticProperties.HeadingLevel="Level2" />
                    </Border>

                    <BoxView HeightRequest="1"
                             BackgroundColor="{StaticResource Gray200}"
                             HorizontalOptions="Fill" />

                    <VerticalStackLayout Padding="30,20" Spacing="5">

                        <!-- Username -->
                        <Label Text="Username:"
                               TextColor="{StaticResource Secondary}"
                               FontAttributes="Bold"
                               HorizontalTextAlignment="Center"
                               Margin="0,0,0,5" />

                        <Border Style="{StaticResource FormEntryBorder}"
                                HorizontalOptions="Fill">
                            <Entry Text="{Binding Username}"
                                   Placeholder="Username"
                                   HorizontalTextAlignment="Center"
                                   MaxLength="30"
                                   TextColor="{StaticResource Gray900}"
                                   PlaceholderColor="{StaticResource Gray400}"
                                   AutomationId="UsernameEntry" />
                        </Border>

                        <!-- Profile image placeholder -->
                        <Label Text="{Binding ProfileImageSource, StringFormat='Picture: {0}'}"
                               TextColor="{StaticResource Gray400}"
                               FontSize="12"
                               HorizontalTextAlignment="Center"
                               Margin="0,15,0,0" />

                        <!-- Error message -->
                        <Label Text="{Binding ErrorMessage}"
                               TextColor="{StaticResource Danger}"
                               HorizontalTextAlignment="Center"
                               IsVisible="{Binding ErrorMessage, Converter={StaticResource IsStringNotNullOrEmptyConverter}}"
                               Margin="0,5,0,0"
                               AutomationId="ErrorMessageLabel" />

                        <!-- Success message -->
                        <Label Text="{Binding SuccessMessage}"
                               TextColor="{StaticResource Tertiary}"
                               HorizontalTextAlignment="Center"
                               IsVisible="{Binding SuccessMessage, Converter={StaticResource IsStringNotNullOrEmptyConverter}}"
                               Margin="0,5,0,0"
                               AutomationId="SuccessMessageLabel" />

                        <!-- Save Changes button -->
                        <Button Text="Save Changes"
                                Command="{Binding SaveChangesCommand}"
                                IsEnabled="{Binding IsBusy, Converter={StaticResource InvertBoolConverter}}"
                                HorizontalOptions="Fill"
                                MaximumWidthRequest="300"
                                Margin="0,10,0,0"
                                AutomationId="SaveChangesButton" />

                    </VerticalStackLayout>
                </VerticalStackLayout>
            </Border>

            <!-- Log Out link -->
            <VerticalStackLayout Spacing="15" Margin="0,25,0,30">

                <Label Text="Log Out"
                       TextColor="{StaticResource Danger}"
                       TextDecorations="Underline"
                       HorizontalTextAlignment="Center"
                       AutomationId="LogoutLabel"
                       SemanticProperties.Hint="Tap to log out">
                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding LogoutCommand}" />
                    </Label.GestureRecognizers>
                </Label>

            </VerticalStackLayout>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
