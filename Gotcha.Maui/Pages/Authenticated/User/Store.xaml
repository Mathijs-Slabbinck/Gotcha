<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:Gotcha.Maui.ViewModels"
             x:DataType="viewmodels:StoreViewModel"
             x:Class="Gotcha.Maui.Pages.Authenticated.User.Store"
             Title="Store"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{StaticResource OffBlack}">

    <ScrollView>
        <VerticalStackLayout Spacing="0" Padding="0,30,0,0">

            <!-- UNLOCK FEATURES heading -->
            <Label Text="UNLOCK FEATURES"
                   TextColor="{StaticResource Primary}"
                   FontSize="22"
                   FontAttributes="Bold"
                   HorizontalTextAlignment="Center"
                   FontFamily="Bungee"
                   Margin="0,0,0,25" />

            <!-- Game Features card -->
            <Border BackgroundColor="{StaticResource CardBackground}"
                    StrokeShape="RoundRectangle 12"
                    StrokeThickness="0"
                    Margin="20,0"
                    Padding="0">
                <Border.Shadow>
                    <Shadow Brush="{StaticResource PrimaryBrush}"
                            Offset="0,0"
                            Radius="20"
                            Opacity="0.4" />
                </Border.Shadow>

                <VerticalStackLayout Spacing="0">

                    <Border BackgroundColor="{StaticResource CardBackground}"
                            StrokeThickness="0"
                            StrokeShape="RoundRectangle 12,12,0,0"
                            Padding="0,14">
                        <Label Text="GAME FEATURES"
                               TextColor="{StaticResource Tertiary}"
                               FontSize="18"
                               FontAttributes="Bold"
                               FontFamily="RobotoSlab"
                               HorizontalTextAlignment="Center" />
                    </Border>

                    <BoxView HeightRequest="1"
                             BackgroundColor="{StaticResource Gray200}"
                             HorizontalOptions="Fill" />

                    <VerticalStackLayout Padding="20,15" Spacing="12">

                        <!-- Assassin Mode -->
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                            <Label Grid.Column="0" TextColor="{StaticResource Gray900}">
                                <Label.FormattedText>
                                    <FormattedString>
                                        <Span Text="Assassin Mode" FontAttributes="Bold" />
                                        <Span Text=" — $3.00" TextColor="{StaticResource Gray500}" />
                                    </FormattedString>
                                </Label.FormattedText>
                            </Label>
                            <Border Grid.Column="1"
                                    BackgroundColor="{StaticResource Success}"
                                    StrokeThickness="0"
                                    StrokeShape="RoundRectangle 8"
                                    Padding="12,4"
                                    IsVisible="{Binding AssassinUnlocked}">
                                <Label Text="Owned" TextColor="{StaticResource White}" FontSize="12" FontAttributes="Bold" />
                            </Border>
                            <Button Grid.Column="1"
                                    Text="Buy"
                                    Command="{Binding BuyFeatureCommand}"
                                    CommandParameter="Assassin Mode"
                                    HeightRequest="35"
                                    Padding="15,0"
                                    FontSize="13"
                                    IsVisible="{Binding AssassinUnlocked, Converter={StaticResource InvertBoolConverter}}"
                                    AutomationId="BuyAssassinButton" />
                        </Grid>

                        <!-- Chaos Mode -->
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                            <Label Grid.Column="0" TextColor="{StaticResource Gray900}">
                                <Label.FormattedText>
                                    <FormattedString>
                                        <Span Text="Chaos Mode" FontAttributes="Bold" />
                                        <Span Text=" — $2.00" TextColor="{StaticResource Gray500}" />
                                    </FormattedString>
                                </Label.FormattedText>
                            </Label>
                            <Border Grid.Column="1"
                                    BackgroundColor="{StaticResource Success}"
                                    StrokeThickness="0"
                                    StrokeShape="RoundRectangle 8"
                                    Padding="12,4"
                                    IsVisible="{Binding ChaosUnlocked}">
                                <Label Text="Owned" TextColor="{StaticResource White}" FontSize="12" FontAttributes="Bold" />
                            </Border>
                            <Button Grid.Column="1"
                                    Text="Buy"
                                    Command="{Binding BuyFeatureCommand}"
                                    CommandParameter="Chaos Mode"
                                    HeightRequest="35"
                                    Padding="15,0"
                                    FontSize="13"
                                    IsVisible="{Binding ChaosUnlocked, Converter={StaticResource InvertBoolConverter}}"
                                    AutomationId="BuyChaosButton" />
                        </Grid>

                        <!-- Timed Kills -->
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                            <Label Grid.Column="0" TextColor="{StaticResource Gray900}">
                                <Label.FormattedText>
                                    <FormattedString>
                                        <Span Text="Timed Kills" FontAttributes="Bold" />
                                        <Span Text=" — $2.00" TextColor="{StaticResource Gray500}" />
                                    </FormattedString>
                                </Label.FormattedText>
                            </Label>
                            <Border Grid.Column="1"
                                    BackgroundColor="{StaticResource Success}"
                                    StrokeThickness="0"
                                    StrokeShape="RoundRectangle 8"
                                    Padding="12,4"
                                    IsVisible="{Binding TimedKillsUnlocked}">
                                <Label Text="Owned" TextColor="{StaticResource White}" FontSize="12" FontAttributes="Bold" />
                            </Border>
                            <Button Grid.Column="1"
                                    Text="Buy"
                                    Command="{Binding BuyFeatureCommand}"
                                    CommandParameter="Timed Kills"
                                    HeightRequest="35"
                                    Padding="15,0"
                                    FontSize="13"
                                    IsVisible="{Binding TimedKillsUnlocked, Converter={StaticResource InvertBoolConverter}}"
                                    AutomationId="BuyTimedKillsButton" />
                        </Grid>

                        <!-- Custom Kill Methods -->
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                            <Label Grid.Column="0" TextColor="{StaticResource Gray900}">
                                <Label.FormattedText>
                                    <FormattedString>
                                        <Span Text="Custom Kill Methods" FontAttributes="Bold" />
                                        <Span Text=" — $2.00" TextColor="{StaticResource Gray500}" />
                                    </FormattedString>
                                </Label.FormattedText>
                            </Label>
                            <Border Grid.Column="1"
                                    BackgroundColor="{StaticResource Success}"
                                    StrokeThickness="0"
                                    StrokeShape="RoundRectangle 8"
                                    Padding="12,4"
                                    IsVisible="{Binding CustomKillMethodsUnlocked}">
                                <Label Text="Owned" TextColor="{StaticResource White}" FontSize="12" FontAttributes="Bold" />
                            </Border>
                            <Button Grid.Column="1"
                                    Text="Buy"
                                    Command="{Binding BuyFeatureCommand}"
                                    CommandParameter="Custom Kill Methods"
                                    HeightRequest="35"
                                    Padding="15,0"
                                    FontSize="13"
                                    IsVisible="{Binding CustomKillMethodsUnlocked, Converter={StaticResource InvertBoolConverter}}"
                                    AutomationId="BuyCustomKillMethodsButton" />
                        </Grid>

                    </VerticalStackLayout>
                </VerticalStackLayout>
            </Border>

            <!-- Lobby Size card -->
            <Border BackgroundColor="{StaticResource CardBackground}"
                    StrokeShape="RoundRectangle 12"
                    StrokeThickness="0"
                    Margin="20,20,20,0"
                    Padding="0">
                <Border.Shadow>
                    <Shadow Brush="{StaticResource PrimaryBrush}"
                            Offset="0,0"
                            Radius="20"
                            Opacity="0.4" />
                </Border.Shadow>

                <VerticalStackLayout Spacing="0">

                    <Border BackgroundColor="{StaticResource CardBackground}"
                            StrokeThickness="0"
                            StrokeShape="RoundRectangle 12,12,0,0"
                            Padding="0,14">
                        <Label Text="LOBBY SIZE"
                               TextColor="{StaticResource Tertiary}"
                               FontSize="18"
                               FontAttributes="Bold"
                               FontFamily="RobotoSlab"
                               HorizontalTextAlignment="Center" />
                    </Border>

                    <BoxView HeightRequest="1"
                             BackgroundColor="{StaticResource Gray200}"
                             HorizontalOptions="Fill" />

                    <VerticalStackLayout Padding="20,15" Spacing="12">

                        <!-- 100 Players -->
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                            <Label Grid.Column="0" TextColor="{StaticResource Gray900}">
                                <Label.FormattedText>
                                    <FormattedString>
                                        <Span Text="100 Players" FontAttributes="Bold" />
                                        <Span Text=" — $1.50" TextColor="{StaticResource Gray500}" />
                                    </FormattedString>
                                </Label.FormattedText>
                            </Label>
                            <Border Grid.Column="1"
                                    BackgroundColor="{StaticResource Success}"
                                    StrokeThickness="0"
                                    StrokeShape="RoundRectangle 8"
                                    Padding="12,4"
                                    IsVisible="{Binding Lobby100Owned}">
                                <Label Text="Owned" TextColor="{StaticResource White}" FontSize="12" FontAttributes="Bold" />
                            </Border>
                            <Button Grid.Column="1"
                                    Text="Buy"
                                    Command="{Binding BuyFeatureCommand}"
                                    CommandParameter="100 Player Lobby"
                                    HeightRequest="35"
                                    Padding="15,0"
                                    FontSize="13"
                                    IsVisible="{Binding Lobby100Owned, Converter={StaticResource InvertBoolConverter}}"
                                    AutomationId="BuyLobby100Button" />
                        </Grid>

                        <!-- 150 Players -->
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                            <Label Grid.Column="0" TextColor="{StaticResource Gray900}">
                                <Label.FormattedText>
                                    <FormattedString>
                                        <Span Text="150 Players" FontAttributes="Bold" />
                                        <Span Text=" — $3.00" TextColor="{StaticResource Gray500}" />
                                    </FormattedString>
                                </Label.FormattedText>
                            </Label>
                            <Border Grid.Column="1"
                                    BackgroundColor="{StaticResource Success}"
                                    StrokeThickness="0"
                                    StrokeShape="RoundRectangle 8"
                                    Padding="12,4"
                                    IsVisible="{Binding Lobby150Owned}">
                                <Label Text="Owned" TextColor="{StaticResource White}" FontSize="12" FontAttributes="Bold" />
                            </Border>
                            <Button Grid.Column="1"
                                    Text="Buy"
                                    Command="{Binding BuyFeatureCommand}"
                                    CommandParameter="150 Player Lobby"
                                    HeightRequest="35"
                                    Padding="15,0"
                                    FontSize="13"
                                    IsVisible="{Binding Lobby150Owned, Converter={StaticResource InvertBoolConverter}}"
                                    AutomationId="BuyLobby150Button" />
                        </Grid>

                        <!-- 500 Players -->
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                            <Label Grid.Column="0" TextColor="{StaticResource Gray900}">
                                <Label.FormattedText>
                                    <FormattedString>
                                        <Span Text="500 Players" FontAttributes="Bold" />
                                        <Span Text=" — $6.00" TextColor="{StaticResource Gray500}" />
                                    </FormattedString>
                                </Label.FormattedText>
                            </Label>
                            <Border Grid.Column="1"
                                    BackgroundColor="{StaticResource Success}"
                                    StrokeThickness="0"
                                    StrokeShape="RoundRectangle 8"
                                    Padding="12,4"
                                    IsVisible="{Binding Lobby500Owned}">
                                <Label Text="Owned" TextColor="{StaticResource White}" FontSize="12" FontAttributes="Bold" />
                            </Border>
                            <Button Grid.Column="1"
                                    Text="Buy"
                                    Command="{Binding BuyFeatureCommand}"
                                    CommandParameter="500 Player Lobby"
                                    HeightRequest="35"
                                    Padding="15,0"
                                    FontSize="13"
                                    IsVisible="{Binding Lobby500Owned, Converter={StaticResource InvertBoolConverter}}"
                                    AutomationId="BuyLobby500Button" />
                        </Grid>

                        <!-- 10000 Players -->
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                            <Label Grid.Column="0" TextColor="{StaticResource Gray900}">
                                <Label.FormattedText>
                                    <FormattedString>
                                        <Span Text="10,000 Players" FontAttributes="Bold" />
                                        <Span Text=" — $10.00" TextColor="{StaticResource Gray500}" />
                                    </FormattedString>
                                </Label.FormattedText>
                            </Label>
                            <Border Grid.Column="1"
                                    BackgroundColor="{StaticResource Success}"
                                    StrokeThickness="0"
                                    StrokeShape="RoundRectangle 8"
                                    Padding="12,4"
                                    IsVisible="{Binding Lobby10000Owned}">
                                <Label Text="Owned" TextColor="{StaticResource White}" FontSize="12" FontAttributes="Bold" />
                            </Border>
                            <Button Grid.Column="1"
                                    Text="Buy"
                                    Command="{Binding BuyFeatureCommand}"
                                    CommandParameter="10000 Player Lobby"
                                    HeightRequest="35"
                                    Padding="15,0"
                                    FontSize="13"
                                    IsVisible="{Binding Lobby10000Owned, Converter={StaticResource InvertBoolConverter}}"
                                    AutomationId="BuyLobby10000Button" />
                        </Grid>

                    </VerticalStackLayout>
                </VerticalStackLayout>
            </Border>

            <!-- Subscription Plans card -->
            <Border BackgroundColor="{StaticResource CardBackground}"
                    StrokeShape="RoundRectangle 12"
                    StrokeThickness="0"
                    Margin="20,20,20,0"
                    Padding="0">
                <Border.Shadow>
                    <Shadow Brush="{StaticResource PrimaryBrush}"
                            Offset="0,0"
                            Radius="20"
                            Opacity="0.4" />
                </Border.Shadow>

                <VerticalStackLayout Spacing="0">

                    <Border BackgroundColor="{StaticResource CardBackground}"
                            StrokeThickness="0"
                            StrokeShape="RoundRectangle 12,12,0,0"
                            Padding="0,14">
                        <Label Text="SUBSCRIPTION PLANS"
                               TextColor="{StaticResource Tertiary}"
                               FontSize="18"
                               FontAttributes="Bold"
                               FontFamily="RobotoSlab"
                               HorizontalTextAlignment="Center" />
                    </Border>

                    <BoxView HeightRequest="1"
                             BackgroundColor="{StaticResource Gray200}"
                             HorizontalOptions="Fill" />

                    <VerticalStackLayout Padding="20,15" Spacing="20">

                        <!-- Standard Plan -->
                        <VerticalStackLayout Spacing="5">
                            <Label Text="Standard — Free"
                                   TextColor="{StaticResource Gray900}"
                                   FontAttributes="Bold"
                                   FontSize="16" />
                            <Label Text="• Max 50 players per game"
                                   TextColor="{StaticResource Gray600}" FontSize="13" />
                            <Label Text="• Basic game features"
                                   TextColor="{StaticResource Gray600}" FontSize="13" />

                            <Border BackgroundColor="{StaticResource Primary}"
                                    StrokeThickness="0"
                                    StrokeShape="RoundRectangle 8"
                                    Padding="12,4"
                                    HorizontalOptions="Start"
                                    Margin="0,5,0,0"
                                    IsVisible="{Binding IsStandardPlan}">
                                <Label Text="Current Plan" TextColor="{StaticResource White}" FontSize="12" FontAttributes="Bold" />
                            </Border>
                        </VerticalStackLayout>

                        <BoxView HeightRequest="1" BackgroundColor="{StaticResource Gray100}" HorizontalOptions="Fill" />

                        <!-- Premium Plan -->
                        <VerticalStackLayout Spacing="5">
                            <Label Text="Premium — $1.50/week"
                                   TextColor="{StaticResource Gray900}"
                                   FontAttributes="Bold"
                                   FontSize="16" />
                            <Label Text="• Max 100 players per game"
                                   TextColor="{StaticResource Gray600}" FontSize="13" />
                            <Label Text="• Priority support"
                                   TextColor="{StaticResource Gray600}" FontSize="13" />

                            <Border BackgroundColor="{StaticResource Primary}"
                                    StrokeThickness="0"
                                    StrokeShape="RoundRectangle 8"
                                    Padding="12,4"
                                    HorizontalOptions="Start"
                                    Margin="0,5,0,0"
                                    IsVisible="{Binding IsPremiumPlan}">
                                <Label Text="Current Plan" TextColor="{StaticResource White}" FontSize="12" FontAttributes="Bold" />
                            </Border>
                            <Button Text="Subscribe"
                                    Command="{Binding SubscribeCommand}"
                                    CommandParameter="Premium"
                                    HeightRequest="35"
                                    Padding="15,0"
                                    FontSize="13"
                                    HorizontalOptions="Start"
                                    IsVisible="{Binding IsPremiumPlan, Converter={StaticResource InvertBoolConverter}}"
                                    AutomationId="SubscribePremiumButton" />
                        </VerticalStackLayout>

                        <BoxView HeightRequest="1" BackgroundColor="{StaticResource Gray100}" HorizontalOptions="Fill" />

                        <!-- Deluxe Plan -->
                        <VerticalStackLayout Spacing="5">
                            <Label Text="Deluxe — $3.00/week"
                                   TextColor="{StaticResource Gray900}"
                                   FontAttributes="Bold"
                                   FontSize="16" />
                            <Label Text="• Max 1000 players per game"
                                   TextColor="{StaticResource Gray600}" FontSize="13" />
                            <Label Text="• All features unlocked"
                                   TextColor="{StaticResource Gray600}" FontSize="13" />
                            <Label Text="• Priority support"
                                   TextColor="{StaticResource Gray600}" FontSize="13" />

                            <Border BackgroundColor="{StaticResource Primary}"
                                    StrokeThickness="0"
                                    StrokeShape="RoundRectangle 8"
                                    Padding="12,4"
                                    HorizontalOptions="Start"
                                    Margin="0,5,0,0"
                                    IsVisible="{Binding IsDeluxePlan}">
                                <Label Text="Current Plan" TextColor="{StaticResource White}" FontSize="12" FontAttributes="Bold" />
                            </Border>
                            <Button Text="Subscribe"
                                    Command="{Binding SubscribeCommand}"
                                    CommandParameter="Deluxe"
                                    HeightRequest="35"
                                    Padding="15,0"
                                    FontSize="13"
                                    HorizontalOptions="Start"
                                    IsVisible="{Binding IsDeluxePlan, Converter={StaticResource InvertBoolConverter}}"
                                    AutomationId="SubscribeDeluxeButton" />
                        </VerticalStackLayout>

                    </VerticalStackLayout>
                </VerticalStackLayout>
            </Border>

            <!-- Bottom spacer -->
            <BoxView HeightRequest="30" BackgroundColor="Transparent" />

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
