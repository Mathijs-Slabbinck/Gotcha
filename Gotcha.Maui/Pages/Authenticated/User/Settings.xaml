<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:Gotcha.Maui.ViewModels"
             x:DataType="viewmodels:SettingsViewModel"
             x:Class="Gotcha.Maui.Pages.Authenticated.User.Settings"
             Title="Settings"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{StaticResource OffBlack}">

    <ScrollView>
        <VerticalStackLayout Spacing="0" VerticalOptions="Center" Padding="0,30,0,0">

            <!-- USER SETTINGS heading -->
            <Label Text="USER SETTINGS"
                   TextColor="{StaticResource Primary}"
                   FontSize="22"
                   FontAttributes="Bold"
                   HorizontalTextAlignment="Center"
                   FontFamily="Bungee"
                   Margin="0,0,0,25" />

            <!-- Edit Profile card -->
            <Border BackgroundColor="{StaticResource CardBackground}"
                    StrokeShape="RoundRectangle 12"
                    StrokeThickness="0"
                    Margin="20,0"
                    Padding="0">
                <Border.Shadow>
                    <Shadow Brush="{StaticResource PrimaryBrush}"
                            Offset="0,0"
                            Radius="20"
                            Opacity="0.4" />
                </Border.Shadow>

                <VerticalStackLayout Spacing="0">

                    <!-- Card header -->
                    <Border BackgroundColor="{StaticResource CardBackground}"
                            StrokeThickness="0"
                            StrokeShape="RoundRectangle 12,12,0,0"
                            Padding="0,14">
                        <Label Text="EDIT PROFILE"
                               TextColor="{StaticResource Tertiary}"
                               FontSize="20"
                               FontAttributes="Bold"
                               FontFamily="RobotoSlab"
                               HorizontalTextAlignment="Center" />
                    </Border>

                    <BoxView HeightRequest="1"
                             BackgroundColor="{StaticResource Gray200}"
                             HorizontalOptions="Fill" />

                    <!-- Form content -->
                    <VerticalStackLayout Padding="30,20" Spacing="5">

                        <!-- First Name -->
                        <Label Text="First Name:"
                               TextColor="{StaticResource Tertiary}"
                               FontAttributes="Bold"
                               HorizontalTextAlignment="Center"
                               Margin="0,0,0,5" />

                        <Border Stroke="{StaticResource Secondary}"
                                StrokeThickness="2"
                                StrokeShape="RoundRectangle 4"
                                Padding="8,0"
                                BackgroundColor="{StaticResource White}"
                                HorizontalOptions="Fill">
                            <Entry Text="{Binding FirstName}"
                                   Placeholder="First name"
                                   HorizontalTextAlignment="Center"
                                   MaxLength="50"
                                   TextColor="{StaticResource Gray900}"
                                   PlaceholderColor="{StaticResource Gray400}"
                                   BackgroundColor="Transparent"
                                   AutomationId="FirstNameEntry" />
                        </Border>

                        <!-- Last Name -->
                        <Label Text="Last Name:"
                               TextColor="{StaticResource Tertiary}"
                               FontAttributes="Bold"
                               HorizontalTextAlignment="Center"
                               Margin="0,15,0,5" />

                        <Border Stroke="{StaticResource Secondary}"
                                StrokeThickness="2"
                                StrokeShape="RoundRectangle 4"
                                Padding="8,0"
                                BackgroundColor="{StaticResource White}"
                                HorizontalOptions="Fill">
                            <Entry Text="{Binding LastName}"
                                   Placeholder="Last name"
                                   HorizontalTextAlignment="Center"
                                   MaxLength="50"
                                   TextColor="{StaticResource Gray900}"
                                   PlaceholderColor="{StaticResource Gray400}"
                                   BackgroundColor="Transparent"
                                   AutomationId="LastNameEntry" />
                        </Border>

                        <!-- Username -->
                        <Label Text="Username:"
                               TextColor="{StaticResource Tertiary}"
                               FontAttributes="Bold"
                               HorizontalTextAlignment="Center"
                               Margin="0,15,0,5" />

                        <Border Stroke="{StaticResource Secondary}"
                                StrokeThickness="2"
                                StrokeShape="RoundRectangle 4"
                                Padding="8,0"
                                BackgroundColor="{StaticResource White}"
                                HorizontalOptions="Fill">
                            <Entry Text="{Binding Username}"
                                   Placeholder="Username"
                                   HorizontalTextAlignment="Center"
                                   MaxLength="30"
                                   TextColor="{StaticResource Gray900}"
                                   PlaceholderColor="{StaticResource Gray400}"
                                   BackgroundColor="Transparent"
                                   AutomationId="UsernameEntry" />
                        </Border>

                        <!-- Email -->
                        <Label Text="Email:"
                               TextColor="{StaticResource Tertiary}"
                               FontAttributes="Bold"
                               HorizontalTextAlignment="Center"
                               Margin="0,15,0,5" />

                        <Border Stroke="{StaticResource Secondary}"
                                StrokeThickness="2"
                                StrokeShape="RoundRectangle 4"
                                Padding="8,0"
                                BackgroundColor="{StaticResource White}"
                                HorizontalOptions="Fill">
                            <Entry Text="{Binding Email}"
                                   Placeholder="Email"
                                   Keyboard="Email"
                                   HorizontalTextAlignment="Center"
                                   MaxLength="254"
                                   TextColor="{StaticResource Gray900}"
                                   PlaceholderColor="{StaticResource Gray400}"
                                   BackgroundColor="Transparent"
                                   AutomationId="EmailEntry" />
                        </Border>

                        <!-- Birthday -->
                        <Label Text="Birthday:"
                               TextColor="{StaticResource Tertiary}"
                               FontAttributes="Bold"
                               HorizontalTextAlignment="Center"
                               Margin="0,15,0,5" />

                        <DatePicker Date="{Binding Birthday}"
                                    TextColor="{StaticResource Gray900}"
                                    HorizontalOptions="Center"
                                    MinimumDate="1900-01-01"
                                    MaximumDate="2015-01-01"
                                    AutomationId="BirthdayPicker" />

                        <!-- Picture placeholder -->
                        <Label Text="Picture: Not yet implemented"
                               TextColor="{StaticResource Gray400}"
                               FontSize="12"
                               HorizontalTextAlignment="Center"
                               Margin="0,15,0,0" />

                        <!-- Error message -->
                        <Label Text="{Binding ErrorMessage}"
                               TextColor="{StaticResource Danger}"
                               HorizontalTextAlignment="Center"
                               IsVisible="{Binding ErrorMessage, Converter={StaticResource IsStringNotNullOrEmptyConverter}}"
                               Margin="0,5,0,0"
                               AutomationId="ErrorMessageLabel" />

                        <!-- Success message -->
                        <Label Text="{Binding SuccessMessage}"
                               TextColor="{StaticResource Tertiary}"
                               HorizontalTextAlignment="Center"
                               IsVisible="{Binding SuccessMessage, Converter={StaticResource IsStringNotNullOrEmptyConverter}}"
                               Margin="0,5,0,0"
                               AutomationId="SuccessMessageLabel" />

                        <!-- Save Changes button -->
                        <Button Text="Save Changes"
                                Command="{Binding SaveChangesCommand}"
                                IsEnabled="{Binding IsBusy, Converter={StaticResource InvertBoolConverter}}"
                                HorizontalOptions="Center"
                                WidthRequest="220"
                                Margin="0,10,0,0"
                                AutomationId="SaveChangesButton" />

                    </VerticalStackLayout>
                </VerticalStackLayout>
            </Border>

            <!-- Bottom links -->
            <VerticalStackLayout Spacing="15" Margin="0,25,0,30">

                <Label Text="Reset Password"
                       TextColor="{StaticResource Secondary}"
                       TextDecorations="Underline"
                       HorizontalTextAlignment="Center"
                       AutomationId="ResetPasswordLabel"
                       SemanticProperties.Hint="Tap to reset your password">
                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding ResetPasswordCommand}" />
                    </Label.GestureRecognizers>
                </Label>

                <Label Text="Unlock Features"
                       TextColor="{StaticResource Secondary}"
                       TextDecorations="Underline"
                       HorizontalTextAlignment="Center"
                       AutomationId="UnlockFeaturesLabel"
                       SemanticProperties.Hint="Tap to go to the store">
                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding UnlockFeaturesCommand}" />
                    </Label.GestureRecognizers>
                </Label>

            </VerticalStackLayout>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
