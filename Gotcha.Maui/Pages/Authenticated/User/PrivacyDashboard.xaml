<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:Gotcha.Maui.ViewModels"
             x:DataType="viewmodels:PrivacyDashboardViewModel"
             x:Class="Gotcha.Maui.Pages.Authenticated.User.PrivacyDashboard"
             Title="Privacy Dashboard"
             Shell.NavBarIsVisible="True"
             BackgroundColor="{StaticResource OffBlack}">

    <ScrollView>
        <VerticalStackLayout Spacing="0" VerticalOptions="Start" Padding="0,30,0,30">

            <!-- Page heading -->
            <Label Text="PRIVACY DASHBOARD"
                   TextColor="{StaticResource Primary}"
                   FontSize="22"
                   FontAttributes="Bold"
                   HorizontalTextAlignment="Center"
                   FontFamily="Bungee"
                   Margin="0,0,0,25" />

            <!-- Your Data card -->
            <Border BackgroundColor="{StaticResource CardBackground}"
                    StrokeShape="RoundRectangle 12"
                    StrokeThickness="0"
                    Margin="20,0"
                    Padding="0">
                <Border.Shadow>
                    <Shadow Brush="{StaticResource PrimaryBrush}"
                            Offset="0,0"
                            Radius="20"
                            Opacity="0.4" />
                </Border.Shadow>

                <VerticalStackLayout Spacing="0">

                    <!-- Card header -->
                    <Border BackgroundColor="{StaticResource CardBackground}"
                            StrokeThickness="0"
                            StrokeShape="RoundRectangle 12,12,0,0"
                            Padding="0,14">
                        <Label Text="YOUR DATA"
                               TextColor="{StaticResource Tertiary}"
                               FontSize="20"
                               FontAttributes="Bold"
                               FontFamily="RobotoSlab"
                               HorizontalTextAlignment="Center" />
                    </Border>

                    <BoxView HeightRequest="1"
                             BackgroundColor="{StaticResource Gray200}"
                             HorizontalOptions="Fill" />

                    <!-- Body -->
                    <VerticalStackLayout Padding="25,20" Spacing="10">

                        <!-- Download section -->
                        <Label Text="Download My Data"
                               TextColor="{StaticResource Tertiary}"
                               FontAttributes="Bold"
                               FontFamily="RobotoSlab"
                               FontSize="16"
                               Margin="0,0,0,5" />

                        <Label Text="Get a copy of the personal data we hold about you — profile details, games you joined, and your kill/death records — as a JSON file you can save to your device."
                               TextColor="{StaticResource White}"
                               FontFamily="Roboto"
                               FontSize="13" />

                        <Button Text="Download My Data"
                                Command="{Binding DownloadDataCommand}"
                                IsEnabled="{Binding IsBusy, Converter={StaticResource InvertBoolConverter}}"
                                HorizontalOptions="Center"
                                WidthRequest="220"
                                Margin="0,10,0,10"
                                AutomationId="DownloadDataButton" />

                        <BoxView HeightRequest="1"
                                 BackgroundColor="{StaticResource Gray200}"
                                 Opacity="0.3"
                                 Margin="0,10" />

                        <!-- Delete section -->
                        <Label Text="Delete Account"
                               TextColor="{StaticResource Tertiary}"
                               FontAttributes="Bold"
                               FontFamily="RobotoSlab"
                               FontSize="16"
                               Margin="0,0,0,5" />

                        <Label Text="This will deactivate your account and hide your personal information (name, email, profile image) from other users. Your game history (kills, scores, results) will be kept under the name 'Deleted User' so other players' records stay intact."
                               TextColor="{StaticResource White}"
                               FontFamily="Roboto"
                               FontSize="13" />

                        <Label Text="If you also want your game history fully removed, you can request this via the contact form after deleting your account."
                               TextColor="{StaticResource White}"
                               FontFamily="Roboto"
                               FontSize="13"
                               Margin="0,5,0,0" />

                        <Button Text="Delete My Account"
                                Command="{Binding DeleteAccountCommand}"
                                IsEnabled="{Binding IsBusy, Converter={StaticResource InvertBoolConverter}}"
                                BackgroundColor="{StaticResource Danger}"
                                TextColor="{StaticResource White}"
                                HorizontalOptions="Center"
                                WidthRequest="220"
                                Margin="0,10,0,0"
                                AutomationId="DeleteAccountButton" />

                        <Label Text="{Binding ErrorMessage}"
                               TextColor="{StaticResource Danger}"
                               HorizontalTextAlignment="Center"
                               IsVisible="{Binding ErrorMessage, Converter={StaticResource IsStringNotNullOrEmptyConverter}}"
                               Margin="0,10,0,0"
                               AutomationId="ErrorMessageLabel" />

                    </VerticalStackLayout>
                </VerticalStackLayout>
            </Border>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
