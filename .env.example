# Copy this file to ".env" in the same folder and fill in the values.
# The real .env file is gitignored — NEVER commit it.
#
# ASP.NET maps env var names to config keys using "__" for nesting:
#   PayPal__Secret    ->    builder.Configuration["PayPal:Secret"]
#
# Both Gotcha.Web and Gotcha.API load this file via DotNetEnv.Env.TraversePath().Load()
# in Program.cs.

# PayPal sandbox credentials — https://developer.paypal.com/dashboard/applications/sandbox
PayPal__ClientId=
PayPal__Secret=